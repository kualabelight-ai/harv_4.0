          "variables_data": {
            "описание_вступление": {
              "name": "описание_вступление",
              "description": "Вводное описание назначения и общего функционала товара",
              "values": [
                "Кратко опиши назначение и функционал товара",
                "Дай сжатый обзор ключевых особенностей товара",
                "Укажи основное предназначение и конструктивные особенности товара",
