        },
        {
          "id": "block_description_template_1",
          "fragment_name": "Алюминиевый_слиток_описание",
          "original_text": "Слитки из алюминия широко применяются в промышленности благодаря легкости и высокой коррозионной стойкости. Они подходят для производства деталей, конструкций и упаковки. Методы контроля качества включают спектральный анализ, проверку механических свойств и визуальный осмотр. Эти процедуры гарантируют соответствие стандартам и требованиям к материалу.",
          "processed_text": "Слитки из алюминия широко применяются в промышленности благодаря легкости и высокой коррозионной стойкости. Они подходят для производства деталей, конструкций и упаковки. Методы контроля качества включают спектральный анализ, проверку механических свойств и визуальный осмотр. Эти процедуры гарантируют соответствие стандартам и требованиям к материалу.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
          "status": "processed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
          "special_symbols": [],
          "last_modified": "2026-07-03T15:33:22.595915"
        },
        {
          "id": "block_new_block_1779776713_1",
          "fragment_name": "Алюминиевый_слиток_свойства",
          "original_text": "Слиток алюминия содержит магний, кремний и медь. Магний повышает коррозионную стойкость, а кремний улучшает текучесть при литье. Медь способствует увеличению прочности, что делает изделие более устойчивым к механическим воздействиям.",
          "processed_text": "Слиток алюминия содержит магний, кремний и медь. Магний повышает коррозионную стойкость, а кремний улучшает текучесть при литье. Медь способствует увеличению прочности, что делает изделие более устойчивым к механическим воздействиям.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
          "status": "processed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
          "special_symbols": [],
          "last_modified": "2026-07-03T15:33:22.595915"
        },
        {
          "id": "block_new_block_1779778327_1",
          "fragment_name": "Алюминиевый_слиток_преимущества",
          "original_text": "Металл, полученный в виде слитков, способствует снижению затрат на производство. Использование алюминиевых слитков позволяет оптимизировать ресурсы и повысить рентабельность проекта.",
          "processed_text": "Металл, полученный в виде слитков, способствует снижению затрат на производство. Использование алюминиевых слитков позволяет оптимизировать ресурсы и повысить рентабельность проекта.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
          "status": "processed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
          "special_symbols": [],
          "last_modified": "2026-07-03T15:33:22.595915"
        },
        {
          "id": "block_new_block_1779778598_1",
          "fragment_name": "Алюминиевый_слиток_разновидности",
          "original_text": "Существует несколько видов данного изделия: литейный, прессованный и кованый. Каждый из них отличается способом производства и применением, например, слиток алюминиевый используется в строительстве и машиностроении.",
          "processed_text": "Существует несколько видов данного изделия: литейный, прессованный и кованый. Каждый из них отличается способом производства и применением, например, слиток алюминиевый используется в строительстве и машиностроении.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [
            {
              "type": "special_symbol",
              "message": "Найдены специальные символы: :"
            }
          ],
          "manually_fixed": false,
          "warnings": [],
          "status": "error",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
          "special_symbols": [
