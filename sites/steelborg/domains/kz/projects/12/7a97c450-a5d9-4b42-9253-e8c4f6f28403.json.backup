        },
        {
          "id": "block_new_block_1779779413_1",
          "fragment_name": "Алюминиевый_слиток_хранение_товара",
          "original_text": "Для защиты от повреждений применяются картонные коробки и пленка. Алюминиевые слитки хранят в помещениях с контролем температуры и влажности, что предотвращает коррозию и деформацию.",
          "processed_text": "Для защиты от повреждений применяются картонные коробки и пленка. Алюминиевые слитки хранят в помещениях с контролем температуры и влажности, что предотвращает коррозию и деформацию.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
