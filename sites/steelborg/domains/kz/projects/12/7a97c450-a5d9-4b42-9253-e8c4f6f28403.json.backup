            ]
          ],
          "last_modified": "2026-07-03T15:33:22.595915"
        },
        {
          "id": "block_new_block_1779778817_1",
          "fragment_name": "Алюминиевый_слиток_подбор",
          "original_text": "При выборе изделия часто игнорируют его легкость и коррозионную стойкость. Неправильная оценка алюминия в слитках может привести к неэффективному использованию в производстве.",
          "processed_text": "При выборе изделия часто игнорируют его легкость и коррозионную стойкость. Неправильная оценка алюминия в слитках может привести к неэффективному использованию в производстве.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
          "status": "processed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
          "special_symbols": [],
          "last_modified": "2026-07-03T15:33:22.595915"
        },
        {
          "id": "block_new_block_1779778987_1",
          "fragment_name": "Алюминиевый_слиток_обработка",
          "original_text": "Методы обработки, такие как сварка или термообработка, могут негативно сказаться на свойствах изделия. Рекомендуется избегать механической обработки с высоким уровнем напряжения, так как это может привести к деформациям. Правильный выбор технологий гарантирует сохранение необходимых характеристик.",
          "processed_text": "Методы обработки, такие как сварка или термообработка, могут негативно сказаться на свойствах изделия. Рекомендуется избегать механической обработки с высоким уровнем напряжения, так как это может привести к деформациям. Правильный выбор технологий гарантирует сохранение необходимых характеристик.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
          "status": "processed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
          "special_symbols": [],
          "last_modified": "2026-07-03T15:33:22.595915"
        },
        {
          "id": "block_new_block_1779779151_1",
          "fragment_name": "Алюминиевый_слиток_контроль_качества",
          "original_text": "Слиток алюминия проходит контроль на наличие примесей, соответствие стандартам и механические свойства. Без этих проверок изделие не допускается к продаже.",
          "processed_text": "Слиток алюминия проходит контроль на наличие примесей, соответствие стандартам и механические свойства. Без этих проверок изделие не допускается к продаже.",
          "html_text": "",
          "block_type": "other",
