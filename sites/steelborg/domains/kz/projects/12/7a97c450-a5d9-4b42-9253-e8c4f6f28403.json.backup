        {
          "id": "char_9113525 01_алюминиевый_1",
          "fragment_name": "Алюминиевый_слиток_Материал",
          "original_text": "При выборе материала важно учитывать его характеристики. Алюминий в слитках требует соблюдения строгих норм безопасности, чтобы избежать рисков при обработке и использовании.",
          "processed_text": "При выборе материала важно учитывать его характеристики. Алюминий в слитках требует соблюдения строгих норм безопасности, чтобы избежать рисков при обработке и использовании.",
          "html_text": "",
          "block_type": "regular",
          "characteristic_name": "Материал",
          "characteristic_value": "алюминиевый",
          "errors": [
            {
