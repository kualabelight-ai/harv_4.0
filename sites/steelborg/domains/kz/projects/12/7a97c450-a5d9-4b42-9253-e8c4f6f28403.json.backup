        },
        {
          "id": "char_9113525 01_алюминиевый_2",
          "fragment_name": "Алюминиевый_слиток_Материал",
          "original_text": "Материал обладает легкостью и высокой коррозионной стойкостью, что делает его популярным в производстве. Слиток алюминиевый легко поддается переработке, что способствует снижению воздействия на окружающую среду.",
          "processed_text": "Материал обладает легкостью и высокой коррозионной стойкостью, что делает его популярным в производстве. Слиток алюминиевый легко поддается переработке, что способствует снижению воздействия на окружающую среду.",
          "html_text": "",
          "block_type": "regular",
          "characteristic_name": "Материал",
          "characteristic_value": "алюминиевый",
          "errors": [
            {
              "type": "missing_bracket",
              "message": "В regular-блоке отсутствует значение [алюминиевый]"
            }
          ],
          "manually_fixed": false,
          "warnings": [],
          "status": "error",
          "manual_correction": null,
          "auto_corrected": false,
