        {
          "id": "block_new_block_1779779151_1",
          "fragment_name": "Известковый_раствор_контроль_качества",
          "original_text": "Контролируются параметры pH, плотность и содержание активных веществ. Раствор извести должен соответствовать стандартам для обеспечения стабильности и качества в строительстве.",
          "processed_text": "Контролируются параметры pH, плотность и содержание активных веществ. Раствор извести должен соответствовать стандартам для обеспечения стабильности и качества в строительстве.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
