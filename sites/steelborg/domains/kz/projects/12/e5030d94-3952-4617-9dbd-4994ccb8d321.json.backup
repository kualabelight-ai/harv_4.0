          "special_symbols": [],
          "last_modified": "2026-07-03T15:40:25.552504"
        },
        {
          "id": "block_new_block_1779778817_4",
          "fragment_name": "Известковый_раствор_подбор",
          "original_text": "При выборе строительной смеси важно учитывать состав, соотношение компонентов и назначение. Раствор извести должен соответствовать требованиям проекта, обеспечивая нужные характеристики для конкретных условий эксплуатации.",
          "processed_text": "При выборе строительной смеси важно учитывать состав, соотношение компонентов и назначение. Раствор извести должен соответствовать требованиям проекта, обеспечивая нужные характеристики для конкретных условий эксплуатации.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
