        },
        {
          "id": "block_new_block_1779778987_4",
          "fragment_name": "Известковый_раствор_обработка",
          "original_text": "Материал подходит для создания прочных конструкций. Не рекомендуется использовать механическую обработку, агрессивные химикаты или высокие температуры. Эти методы могут негативно сказаться на его свойствах и функциональности.",
          "processed_text": "Материал подходит для создания прочных конструкций. Не рекомендуется использовать механическую обработку, агрессивные химикаты или высокие температуры. Эти методы могут негативно сказаться на его свойствах и функциональности.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
