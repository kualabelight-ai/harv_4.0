            }
          }
        },
        "new_block_1779963989": {
          "тема_списка_текст_ai": {
            "dce9c4c6a2755c1eeb4125e59ffe538b": {
              "values": [
                "о применении в строительстве жилых зданий",
                "о назначении в ремонте и отделке",
                "в производстве строительных смесей",
                "для создания декоративных элементов",
                "в ландшафтном дизайне",
                "о применении в реставрации исторических объектов",
                "для изготовления штукатурки",
                "в производстве кирпича и блоков",
                "о назначении в дорожном строительстве",
                "в создании фундамента для сооружений",
                "для защиты от коррозии металлических конструкций",
                "о применении в сельском хозяйстве для улучшения почвы",
                "в производстве цементных изделий",
                "для создания теплоизоляционных материалов",
                "о назначении в гидроизоляции конструкций",
                "в изготовлении искусственного камня",
                "для укрепления склонов и берегов водоемов",
                "о применении в архитектурных проектах",
                "в производстве строительной химии",
                "для создания огнезащитных покрытий",
                "о назначении в системах вентиляции и кондиционирования воздуха",
                "в производстве наливных полов",
                "для улучшения акустических характеристик помещений",
                "о применении в экологическом строительстве",
                "в создании антибактериальных покрытий",
                "для защиты древесины от гниения и насекомых",
                "о назначении в спортивной инфраструктуре для покрытия площадок",
                "в производстве композитных материалов для строительства."
              ],
              "original_values": [
                "о применении в строительстве жилых зданий;о назначении в ремонте и отделке;в производстве строительных смесей;для создания декоративных элементов;в ландшафтном дизайне;о применении в реставрации исторических объектов;для изготовления штукатурки;в производстве кирпича и блоков;о назначении в дорожном строительстве;в создании фундамента для сооружений;для защиты от коррозии металлических конструкций;о применении в сельском хозяйстве для улучшения почвы;в производстве цементных изделий;для создания теплоизоляционных материалов;о назначении в гидроизоляции конструкций;в изготовлении искусственного камня;для укрепления склонов и берегов водоемов;о применении в архитектурных проектах;в производстве строительной химии;для создания огнезащитных покрытий;о назначении в системах вентиляции и кондиционирования воздуха;в производстве наливных полов;для улучшения акустических характеристик помещений;о применении в экологическом строительстве;в создании антибактериальных покрытий;для защиты древесины от гниения и насекомых;о назначении в спортивной инфраструктуре для покрытия площадок;в производстве композитных материалов для строительства."
