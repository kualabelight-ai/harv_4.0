        },
        {
          "id": "block_new_block_1779776713_1",
          "fragment_name": "Известковый_раствор_свойства",
          "original_text": "Содержание кальция в известняковом растворе влияет на его прочность и устойчивость к внешним воздействиям. Наличие магния улучшает пластичность, что облегчает процесс нанесения и формовки.",
          "processed_text": "Содержание кальция в известняковом растворе влияет на его прочность и устойчивость к внешним воздействиям. Наличие магния улучшает пластичность, что облегчает процесс нанесения и формовки.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
