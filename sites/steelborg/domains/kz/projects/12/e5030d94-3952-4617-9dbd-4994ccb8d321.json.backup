        },
        {
          "id": "block_new_block_1779779151_4",
          "fragment_name": "Известковый_раствор_контроль_качества",
          "original_text": "При использовании известнякового раствора допускаются небольшие отклонения в составе, такие как незначительное изменение соотношения компонентов. Критическими считаются несоответствия, влияющие на прочность и устойчивость к внешним воздействиям. Важно соблюдать рекомендованные параметры для достижения оптимальных результатов.",
          "processed_text": "При использовании известнякового раствора допускаются небольшие отклонения в составе, такие как незначительное изменение соотношения компонентов. Критическими считаются несоответствия, влияющие на прочность и устойчивость к внешним воздействиям. Важно соблюдать рекомендованные параметры для достижения оптимальных результатов.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
