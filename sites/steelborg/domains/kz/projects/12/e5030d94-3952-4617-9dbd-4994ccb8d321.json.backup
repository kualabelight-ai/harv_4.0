          "last_modified": "2026-07-13T11:28:40.244898"
        },
        {
          "id": "block_new_block_1779778817_4",
          "fragment_name": "Известковый_раствор_подбор",
          "original_text": "При выборе строительного состава важно учитывать его состав, назначение и условия эксплуатации. Известняковый раствор подходит для внутренних и наружных работ, обеспечивая необходимую адгезию.",
          "processed_text": "При выборе строительного состава важно учитывать его состав, назначение и условия эксплуатации. Известняковый раствор подходит для внутренних и наружных работ, обеспечивая необходимую адгезию.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
