        },
        {
          "id": "char_9125202 01_М-100_1",
          "fragment_name": "Известковый_раствор_Марка_материала",
          "original_text": "Материал марки М-100 подходит для применения в различных климатических условиях благодаря своей устойчивости к изменениям температуры и влажности. Раствор извести обеспечивает надежное сцепление с поверхностями, что делает его универсальным выбором для строительных работ.",
          "processed_text": "Материал марки {prop Марка материала} подходит для применения в различных климатических условиях благодаря своей устойчивости к изменениям температуры и влажности. Раствор извести обеспечивает надежное сцепление с поверхностями, что делает его универсальным выбором для строительных работ.",
          "html_text": "",
          "block_type": "regular",
          "characteristic_name": "Марка материала",
          "characteristic_value": "М-100",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": true,
          "added_value": "М-100",
          "special_symbols": [],
          "last_modified": "2026-07-13T11:28:40.228316"
        },
        {
          "id": "char_9125202 01_М-150_1",
          "fragment_name": "Известковый_раствор_Марка_материала",
          "original_text": "Материал марки М-150, благодаря своим свойствам, демонстрирует высокую адгезию к различным строительным поверхностям. Известняковый раствор подходит для выполнения работ как внутри, так и снаружи зданий.",
          "processed_text": "Материал марки {prop Марка материала}, благодаря своим свойствам, демонстрирует высокую адгезию к различным строительным поверхностям. Известняковый раствор подходит для выполнения работ как внутри, так и снаружи зданий.",
          "html_text": "",
          "block_type": "regular",
          "characteristic_name": "Марка материала",
          "characteristic_value": "М-150",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": true,
          "added_value": "М-150",
          "special_symbols": [],
          "last_modified": "2026-07-13T11:28:40.228316"
        },
        {
          "id": "char_9125202 01_М-200_1",
          "fragment_name": "Известковый_раствор_Марка_материала",
          "original_text": "Материал марки М-200 подходит для создания теплоизоляционного и звукоизоляционного слоя, так как его характеристики позволяют эффективно удерживать тепло, а также снижать уровень шума. Раствор извести используется в строительстве для достижения необходимых свойств.",
          "processed_text": "Материал марки {prop Марка материала} подходит для создания теплоизоляционного и звукоизоляционного слоя, так как его характеристики позволяют эффективно удерживать тепло, а также снижать уровень шума. Раствор извести используется в строительстве для достижения необходимых свойств.",
          "html_text": "",
          "block_type": "regular",
          "characteristic_name": "Марка материала",
          "characteristic_value": "М-200",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
