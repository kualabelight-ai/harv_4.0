        },
        {
          "id": "block_new_block_1779779151_3",
          "fragment_name": "Известковый_раствор_контроль_качества",
          "original_text": "При визуальном контроле ограничивается использование раствора извести в случаях, когда требуется оценка его однородности и консистенции. Если возникают сомнения в качестве, часть партии направляют на испытания для проверки соответствия стандартам. Это позволяет гарантировать надежность применения в строительстве.",
          "processed_text": "При визуальном контроле ограничивается использование раствора извести в случаях, когда требуется оценка его однородности и консистенции. Если возникают сомнения в качестве, часть партии направляют на испытания для проверки соответствия стандартам. Это позволяет гарантировать надежность применения в строительстве.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
