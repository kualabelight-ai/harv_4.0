          "last_modified": "2026-07-13T11:28:40.244898"
        },
        {
          "id": "block_new_block_1779778817_3",
          "fragment_name": "Известковый_раствор_подбор",
          "original_text": "При выборе раствора извести важно учитывать его консистенцию и время высыхания. Оптимальная плотность позволяет достичь необходимой прочности при использовании в строительстве. Также стоит обратить внимание на условия хранения, чтобы избежать потери свойств материала.",
          "processed_text": "При выборе раствора извести важно учитывать его консистенцию и время высыхания. Оптимальная плотность позволяет достичь необходимой прочности при использовании в строительстве. Также стоит обратить внимание на условия хранения, чтобы избежать потери свойств материала.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": false,
