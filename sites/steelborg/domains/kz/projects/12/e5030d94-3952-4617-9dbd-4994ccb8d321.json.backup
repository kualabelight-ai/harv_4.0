          "auto_corrected": false,
          "added_value": null,
          "special_symbols": [],
          "last_modified": "2026-07-13T11:28:40.244898"
        },
        {
          "id": "block_new_block_1779778987_2",
          "fragment_name": "Известковый_раствор_обработка",
          "original_text": "Для повышения характеристик изделия рекомендуется использовать добавки, такие как полимерные компоненты, а также применять методы тщательного смешивания. Правильная пропорция ингредиентов улучшает сцепление с поверхностью.",
          "processed_text": "Для повышения характеристик изделия рекомендуется использовать добавки, такие как полимерные компоненты, а также применять методы тщательного смешивания. Правильная пропорция ингредиентов улучшает сцепление с поверхностью.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
