          "special_symbols": [],
          "last_modified": "2026-07-13T11:28:40.246904"
        },
        {
          "id": "block_new_block_1779779151_2",
          "fragment_name": "Известковый_раствор_контроль_качества",
          "original_text": "Контроль качества начинается с тщательной проверки сырья, которое проходит анализ на соответствие стандартам. Затем осуществляется мониторинг процесса смешивания компонентов, а также тестирование готового продукта на прочность и однородность. В итоге раствор извести подвергается финальной оценке, чтобы гарантировать его соответствие заявленным характеристикам.",
          "processed_text": "Контроль качества начинается с тщательной проверки сырья, которое проходит анализ на соответствие стандартам. Затем осуществляется мониторинг процесса смешивания компонентов, а также тестирование готового продукта на прочность и однородность. В итоге раствор извести подвергается финальной оценке, чтобы гарантировать его соответствие заявленным характеристикам.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": false,
