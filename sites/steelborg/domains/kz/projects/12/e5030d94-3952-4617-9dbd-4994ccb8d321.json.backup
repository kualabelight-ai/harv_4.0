        },
        {
          "id": "block_new_block_1779779413_4",
          "fragment_name": "Известковый_раствор_хранение_товара",
          "original_text": "Для укладки изделий важно соблюдать правильную последовательность. Необходимо использовать раствор извести в соответствии с рекомендациями производителя. Это поможет избежать деформации и повреждений, обеспечивая стабильность конструкции на протяжении всего срока эксплуатации.",
          "processed_text": "Для укладки изделий важно соблюдать правильную последовательность. Необходимо использовать раствор извести в соответствии с рекомендациями производителя. Это поможет избежать деформации и повреждений, обеспечивая стабильность конструкции на протяжении всего срока эксплуатации.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
          "status": "processed",
          "manual_correction": null,
          "auto_corrected": false,
