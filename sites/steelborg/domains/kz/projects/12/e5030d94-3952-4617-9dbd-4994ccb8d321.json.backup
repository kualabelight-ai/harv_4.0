        },
        {
          "id": "block_new_block_1779778327_1",
          "fragment_name": "Известковый_раствор_преимущества",
          "original_text": "Смесь на основе известняка обладает высокой адгезией, что позволяет легко наносить ее на различные поверхности. Такой раствор подходит для внутренних и наружных работ, а также обеспечивает отличную защиту от влаги.",
          "processed_text": "Смесь на основе известняка обладает высокой адгезией, что позволяет легко наносить ее на различные поверхности. Такой раствор подходит для внутренних и наружных работ, а также обеспечивает отличную защиту от влаги.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
