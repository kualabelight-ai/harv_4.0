        },
        {
          "id": "block_description_template_5",
          "fragment_name": "Известковый_раствор_описание",
          "original_text": "Состав включает известь, которая играет ключевую роль в процессе затвердевания. При взаимодействии с водой происходит гидратация, что приводит к образованию карбоната кальция. Этот компонент обеспечивает прочность и стабильность структуры. Раствор извести используется в строительстве для создания надежных соединений, а также для улучшения адгезии материалов.",
          "processed_text": "Состав включает известь, которая играет ключевую роль в процессе затвердевания. При взаимодействии с водой происходит гидратация, что приводит к образованию карбоната кальция. Этот компонент обеспечивает прочность и стабильность структуры. Раствор извести используется в строительстве для создания надежных соединений, а также для улучшения адгезии материалов.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
