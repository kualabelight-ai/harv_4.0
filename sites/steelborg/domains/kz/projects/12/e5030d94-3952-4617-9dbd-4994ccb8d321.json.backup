          "last_modified": "2026-07-13T11:28:40.244898"
        },
        {
          "id": "block_new_block_1779778817_2",
          "fragment_name": "Известковый_раствор_подбор",
          "original_text": "При выборе строительного раствора часто допускаются ошибки. Неправильное соотношение компонентов и недостаточная консистенция могут привести к снижению качества известнякового раствора.",
          "processed_text": "При выборе строительного раствора часто допускаются ошибки. Неправильное соотношение компонентов и недостаточная консистенция могут привести к снижению качества известнякового раствора.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": false,
