        },
        {
          "id": "block_new_block_1779778987_1",
          "fragment_name": "Известковый_раствор_обработка",
          "original_text": "Для улучшения свойств и качества материала применяются методы гашения, добавление полимеров и использование специальных добавок. Эти подходы способствуют повышению пластичности, адгезии и устойчивости к внешним воздействиям. Результатом становится более эффективное применение в строительстве.",
          "processed_text": "Для улучшения свойств и качества материала применяются методы гашения, добавление полимеров и использование специальных добавок. Эти подходы способствуют повышению пластичности, адгезии и устойчивости к внешним воздействиям. Результатом становится более эффективное применение в строительстве.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
