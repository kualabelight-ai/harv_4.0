        },
        {
          "id": "block_new_block_1779779151_1",
          "fragment_name": "Известковый_раствор_контроль_качества",
          "original_text": "Контроль за физико-химическими свойствами включает определение консистенции, водопоглощения и прочности на сжатие. Известняковый раствор должен соответствовать установленным стандартам для обеспечения стабильности в строительстве.",
          "processed_text": "Контроль за физико-химическими свойствами включает определение консистенции, водопоглощения и прочности на сжатие. Известняковый раствор должен соответствовать установленным стандартам для обеспечения стабильности в строительстве.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
