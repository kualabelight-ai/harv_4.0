        },
        {
          "id": "block_new_block_1780481514_1",
          "fragment_name": "Проволока_латунная_технология_производства",
          "original_text": "<h2>Технологии производства проволоки из латуни</h2>  \nПроизводственный процесс включает несколько этапов. Сначала происходит плавка металла, затем формирование заготовок, а после — вытяжка, что позволяет получить проволоку из латуни нужного диаметра.",
          "processed_text": "<h2>Технологии производства проволоки из латуни</h2> \nПроизводственный процесс включает несколько этапов. Сначала происходит плавка металла, затем формирование заготовок, а после - вытяжка, что позволяет получить проволоку из латуни нужного диаметра.",
          "html_text": "<h2>Технологии производства проволоки из латуни</h2>\n<p>Производственный процесс включает несколько этапов. Сначала происходит плавка металла, затем формирование заготовок, а после - вытяжка, что позволяет получить проволоку из латуни нужного диаметра.</p>\n<br>",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
