        },
        {
          "id": "block_new_block_1779778817_1",
          "fragment_name": "Канат_джутовый_подбор",
          "original_text": "При выборе джутового каната важно учитывать его толщину и натяжение. Также стоит обратить внимание на устойчивость к влаге и механическим повреждениям, чтобы избежать быстрого износа.",
          "processed_text": "При выборе джутового каната важно учитывать его толщину и натяжение. Также стоит обратить внимание на устойчивость к влаге и механическим повреждениям, чтобы избежать быстрого износа.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
          "status": "processed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
          "special_symbols": [],
          "last_modified": "2026-07-03T15:19:42.036993"
        },
        {
          "id": "block_new_block_1779778817_2",
          "fragment_name": "Канат_джутовый_подбор",
          "original_text": "При выборе каната из джута важно учитывать его толщину, плотность и способ плетения. Часто игнорируются условия эксплуатации, такие как уровень влажности и воздействие солнечных лучей. Эти факторы могут существенно повлиять на срок службы изделия и его функциональность в различных сферах применения.",
          "processed_text": "При выборе каната из джута важно учитывать его толщину, плотность и способ плетения. Часто игнорируются условия эксплуатации, такие как уровень влажности и воздействие солнечных лучей. Эти факторы могут существенно повлиять на срок службы изделия и его функциональность в различных сферах применения.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
          "status": "processed",
          "manual_correction": null,
          "auto_corrected": false,
