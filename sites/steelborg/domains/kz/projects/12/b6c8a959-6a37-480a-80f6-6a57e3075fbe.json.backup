        },
        {
          "id": "block_new_block_1779779151_1",
          "fragment_name": "Канат_джутовый_контроль_качества",
          "original_text": "При выборе каната из джута важно проверить его на отсутствие повреждений и равномерность волокон. Также стоит оценить прочность на разрыв, чтобы гарантировать соответствие заявленным характеристикам.",
          "processed_text": "При выборе каната из джута важно проверить его на отсутствие повреждений и равномерность волокон. Также стоит оценить прочность на разрыв, чтобы гарантировать соответствие заявленным характеристикам.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
