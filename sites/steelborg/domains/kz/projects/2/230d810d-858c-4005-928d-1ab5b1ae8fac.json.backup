        },
        {
          "id": "block_new_block_1779776713_5",
          "fragment_name": "Полоса_медная_свойства",
          "original_text": "Изделие сохраняет свои свойства на протяжении длительного времени при использовании. Полоса из меди устойчива к коррозии, что делает ее подходящей для различных условий эксплуатации.",
          "processed_text": "Изделие сохраняет свои свойства на протяжении длительного времени при использовании. Полоса из меди устойчива к коррозии, что делает ее подходящей для различных условий эксплуатации.",
          "html_text": "<p>Изделие сохраняет свои свойства на протяжении длительного времени при использовании. Полоса из меди устойчива к коррозии, что делает ее подходящей для различных условий эксплуатации.</p>\n<br>",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
