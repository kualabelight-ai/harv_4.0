        },
        {
          "id": "block_new_block_1779778987_1",
          "fragment_name": "Полоса_медная_обработка",
          "original_text": "Изделие подвергается различным методам обработки, включая резку, гибку и сварку. Эти процессы позволяют добиться нужной формы и размера, а также обеспечивают точность в изготовлении. Использование специализированного оборудования повышает эффективность работы с материалом.",
          "processed_text": "Изделие подвергается различным методам обработки, включая резку, гибку и сварку. Эти процессы позволяют добиться нужной формы и размера, а также обеспечивают точность в изготовлении. Использование специализированного оборудования повышает эффективность работы с материалом.",
          "html_text": "<p>Изделие подвергается различным методам обработки, включая резку, гибку и сварку. Эти процессы позволяют добиться нужной формы и размера, а также обеспечивают точность в изготовлении. Использование специализированного оборудования повышает эффективность работы с материалом.</p>\n<br>",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
