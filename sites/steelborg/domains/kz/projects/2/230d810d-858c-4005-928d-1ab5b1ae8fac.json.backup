        },
        {
          "id": "block_new_block_1779778817_5",
          "fragment_name": "Полоса_медная_подбор",
          "original_text": "При выборе изделия важно учитывать толщину, ширину и качество обработки. Полоса из меди должна соответствовать требованиям проекта, обеспечивая необходимую функциональность и долговечность конструкции.",
          "processed_text": "При выборе изделия важно учитывать толщину, ширину и качество обработки. Полоса из меди должна соответствовать требованиям проекта, обеспечивая необходимую функциональность конструкции.",
          "html_text": "<p>При выборе изделия важно учитывать толщину, ширину и качество обработки. Полоса из меди должна соответствовать требованиям проекта, обеспечивая необходимую функциональность конструкции.</p>\n<br>",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
