    "phase4": {
      "prompts": [
        {
          "characteristic_id": "00001128",
          "characteristic_name": "Ширина",
          "value": "30",
          "prompt_num": 1,
          "type": "regular",
          "prompt": "Сформируй только текст без пояснений\nСтиль — профессиональный, без лишней эмоциональности.\nОбъем: 1-2 предложения, 100–200 символов без пробелов. \n\nНапиши абзац для текста-описания товара по тематике полоса медная, избегай употребления слова &quot;полоса медная&quot;.\nТут крайне внимательно: опиши ширина так, чтобы значение 30 было логично вставлено в текст, \nОбязательно используй \"изделие\" один раз в тексте.  \nСтруктура предложения: Простое повествовательное предложение.\nИзбегай частого повторения «и», заменяй на запятую или «а также», где это уместно.\nТошнота текста ≤ 10%.\nзапрещено использовать вводные слова и следующие слова: долговечность, обеспечивает, надежность, хороший, различный, отличный, хорошо, отлично, прекрасный, красивый, эстетичный, декоративный, интересный, потребитель, современный, конечно, дизайнерская, превосходно, превосходный, уникальный, шедевр, дизайнерские, прочный, прочность, долговечность, долговечный, идеальный, идеально.",
          "unresolved_variables": [],
          "context": {
            "категория": "полоса медная",
            "стоп_слова": "долговечность, обеспечивает, надежность, хороший, различный, отличный, хорошо, отлично, прекрасный, красивый, эстетичный, декоративный, интересный, потребитель, современный, конечно, дизайнерская, превосходно, превосходный, уникальный, шедевр, дизайнерские, прочный, прочность, долговечность, долговечный, идеальный, идеально",
            "маркер": "изделие",
            "название_характеристики": "ширина",
            "значение": "30",
            "тип": "regular",
            "характеристика": "ширина",
            "prompt_num": "1",
            "total_prompts": "5",
            "характеристика_маркер": "изделие"
          },
