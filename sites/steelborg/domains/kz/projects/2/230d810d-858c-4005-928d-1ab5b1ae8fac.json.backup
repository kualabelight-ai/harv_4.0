        },
        {
          "id": "block_new_block_1779776713_4",
          "fragment_name": "Полоса_медная_свойства",
          "original_text": "Изделие обладает высокой электропроводностью и теплопроводностью, что делает его подходящим для электрических и теплотехнических систем. Полоса медная легко поддается обработке, обеспечивая возможность создания различных форм.",
          "processed_text": "Изделие обладает высокой электропроводностью и теплопроводностью, что делает его подходящим для электрических и теплотехнических систем. Полоса медная легко поддается обработке, обеспечивая возможность создания различных форм.",
          "html_text": "<p>Изделие обладает высокой электропроводностью и теплопроводностью, что делает его подходящим для электрических и теплотехнических систем. Полоса медная легко поддается обработке, обеспечивая возможность создания различных форм.</p>\n<br>",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
