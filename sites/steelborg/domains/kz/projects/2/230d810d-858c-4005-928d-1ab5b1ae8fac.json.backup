        },
        {
          "id": "block_new_block_1779778598_14",
          "fragment_name": "Полоса_медная_разновидности",
          "original_text": "Изделие классифицируется по толщине, ширине и степени обработки поверхности. Эти параметры влияют на применение в электротехнике, строительстве и других отраслях. Продукция подходит для создания соединений, проводки и различных конструкций.",
          "processed_text": "Изделие классифицируется по толщине, ширине и степени обработки поверхности. Эти параметры влияют на применение в электротехнике, строительстве и других отраслях. Продукция подходит для создания соединений, проводки и различных конструкций.",
          "html_text": "<p>Изделие классифицируется по толщине, ширине и степени обработки поверхности. Эти параметры влияют на применение в электротехнике, строительстве и других отраслях. Продукция подходит для создания соединений, проводки и различных конструкций.</p>\n<br>",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
