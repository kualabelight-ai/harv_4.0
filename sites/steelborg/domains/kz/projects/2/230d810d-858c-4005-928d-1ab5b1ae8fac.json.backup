        },
        {
          "id": "block_new_block_1779778987_5",
          "fragment_name": "Полоса_медная_обработка",
          "original_text": "Материал обладает высокой теплопроводностью, что позволяет эффективно использовать его в электротехнике. Гибкость упрощает процесс обработки, а также формовки изделий различной конфигурации.",
          "processed_text": "Материал обладает высокой теплопроводностью, что позволяет эффективно использовать его в электротехнике. Гибкость упрощает процесс обработки, а также формовки изделий различной конфигурации.",
          "html_text": "<p>Материал обладает высокой теплопроводностью, что позволяет эффективно использовать его в электротехнике. Гибкость упрощает процесс обработки, а также формовки изделий различной конфигурации.</p>\n<br>",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
