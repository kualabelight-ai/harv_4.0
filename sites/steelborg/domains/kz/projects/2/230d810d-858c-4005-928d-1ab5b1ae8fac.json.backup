        },
        {
          "id": "block_new_block_1779778817_3",
          "fragment_name": "Полоса_медная_подбор",
          "original_text": "При выборе данного изделия важно учитывать толщину и ширину. Неправильные параметры могут привести к трудностям в монтаже или эксплуатации. Также стоит обратить внимание на качество поверхности, так как дефекты могут повлиять на проводимость и срок службы.",
          "processed_text": "При выборе данного изделия важно учитывать толщину и ширину. Неправильные параметры могут привести к трудностям в монтаже или эксплуатации. Также стоит обратить внимание на качество поверхности, так как дефекты могут повлиять на проводимость и срок службы.",
          "html_text": "<p>При выборе данного изделия важно учитывать толщину и ширину. Неправильные параметры могут привести к трудностям в монтаже или эксплуатации. Также стоит обратить внимание на качество поверхности, так как дефекты могут повлиять на проводимость и срок службы.</p>\n<br>",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
