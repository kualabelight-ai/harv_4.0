        {
          "id": "block_description_template_1",
          "fragment_name": "Барьер_описание",
          "original_text": "Изделие сочетает в себе функциональность и стиль, что позволяет гармонично вписаться в любой интерьер. Его лаконичные линии и аккуратные формы создают привлекательный визуальный эффект.",
          "processed_text": "Изделие сочетает в себе функциональность и стиль, что позволяет гармонично вписаться в любой интерьер. Его лаконичные линии и аккуратные формы создают привлекательный визуальный эффект.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
