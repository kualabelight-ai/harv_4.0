        {
          "id": "char_9118679 05_с порошковой окраской_1",
          "fragment_name": "Барьер_Покрытие",
          "original_text": "Покрытие с порошковой окраской обладает высокой устойчивостью к внешним воздействиям, а также защищает от коррозии, в отличие от традиционных лакокрасочных материалов. Продукция с таким покрытием подходит для использования в условиях повышенной влажности и механических нагрузок, но может быть менее гибкой при сильных перепадах температуры.",
          "processed_text": "Покрытие с порошковой окраской обладает высокой устойчивостью к внешним воздействиям, а также защищает от коррозии, в отличие от традиционных лакокрасочных материалов. Продукция с таким покрытием подходит для использования в условиях повышенной влажности и механических нагрузок, но может быть менее гибкой при сильных перепадах температуры.",
          "html_text": "",
          "block_type": "regular",
          "characteristic_name": "Покрытие",
          "characteristic_value": "с порошковой окраской",
          "errors": [
            {
              "type": "missing_bracket",
              "message": "В regular-блоке отсутствует значение [с порошковой окраской]"
            }
          ],
          "manually_fixed": false,
