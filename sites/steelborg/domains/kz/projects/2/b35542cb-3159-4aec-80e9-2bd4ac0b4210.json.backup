        },
        {
          "id": "block_description_template_2",
          "fragment_name": "Круг_пруток_бронзовый_описание",
          "original_text": "Бронзовый кругляк представляет собой металлический пруток с круглым сечением. Он находит применение в машиностроении, строительстве и производстве деталей, требующих устойчивости к коррозии.",
          "processed_text": "Бронзовый кругляк представляет собой металлический пруток с круглым сечением. Он находит применение в машиностроении, строительстве и производстве деталей, требующих устойчивости к коррозии.",
          "html_text": "<p>Бронзовый кругляк представляет собой металлический пруток с круглым сечением. Он находит применение в машиностроении, строительстве и производстве деталей, требующих устойчивости к коррозии.</p>\n<br>",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": false,
