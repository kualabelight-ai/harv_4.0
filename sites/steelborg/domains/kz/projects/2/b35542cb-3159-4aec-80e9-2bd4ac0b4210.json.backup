        {
          "id": "block_new_block_1779779151_1",
          "fragment_name": "Круг_пруток_бронзовый_контроль_качества",
          "original_text": "Изделие проходит комплекс проверок, включая тестирование на соответствие стандартам, анализ химического состава, а также оценку механических свойств. Бронзовый кругляк должен демонстрировать стабильные характеристики в различных условиях эксплуатации.",
          "processed_text": "Изделие проходит комплекс проверок, включая тестирование на соответствие стандартам, анализ химического состава, а также оценку механических свойств. Бронзовый кругляк должен демонстрировать стабильные характеристики в различных условиях эксплуатации.",
          "html_text": "<p>Изделие проходит комплекс проверок, включая тестирование на соответствие стандартам, анализ химического состава, а также оценку механических свойств. Бронзовый кругляк должен демонстрировать стабильные характеристики в различных условиях эксплуатации.</p>\n<br>",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
