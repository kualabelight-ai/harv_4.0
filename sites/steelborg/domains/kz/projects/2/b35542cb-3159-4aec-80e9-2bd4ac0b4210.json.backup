        {
          "id": "char_00007194_полутвердый_3",
          "fragment_name": "Круг_пруток_бронзовый_Состояние_полутвердый",
          "original_text": "Бронзовые круги в полутвердом состоянии обладают высокой устойчивостью к коррозии, что делает их подходящими для использования в сложных условиях. Это свойство обеспечивает долговременную эксплуатацию без значительных повреждений.",
          "processed_text": "Бронзовые круги в полутвердом состоянии обладают высокой устойчивостью к коррозии, что делает их подходящими для использования в сложных условиях. Это свойство обеспечивает долговременную эксплуатацию без значительных повреждений.",
          "html_text": "<p>Бронзовые круги в полутвердом состоянии обладают высокой устойчивостью к коррозии, что делает их подходящими для использования в сложных условиях. Это свойство обеспечивает долговременную эксплуатацию без значительных повреждений.</p>\n<br>",
          "block_type": "unique",
          "characteristic_name": "Состояние",
          "characteristic_value": "полутвердый",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
