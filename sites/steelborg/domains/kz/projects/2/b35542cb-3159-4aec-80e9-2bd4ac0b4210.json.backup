          "last_modified": "2026-07-13T11:30:24.680254"
        },
        {
          "id": "char_00001052_30_2",
          "fragment_name": "Круг_пруток_бронзовый_Диаметр",
          "original_text": "Бронзовый круг с диаметром 30 мм подходит для различных конструкций, так как этот параметр влияет на расчеты нагрузок и деформаций, а также обеспечивает необходимую устойчивость изделий.",
          "processed_text": "Бронзовый круг с диаметром {prop Диаметр} подходит для различных конструкций, так как этот параметр влияет на расчеты нагрузок и деформаций, а также обеспечивает необходимую устойчивость изделий.",
          "html_text": "<p>Бронзовый круг с диаметром {prop Диаметр} подходит для различных конструкций, так как этот параметр влияет на расчеты нагрузок и деформаций, а также обеспечивает необходимую устойчивость изделий.</p>\n<br>",
          "block_type": "regular",
          "characteristic_name": "Диаметр",
          "characteristic_value": "30",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": true,
          "added_value": "30",
          "special_symbols": [],
          "last_modified": "2026-07-13T11:30:24.680254"
        },
        {
          "id": "char_00001052_30_3",
          "fragment_name": "Круг_пруток_бронзовый_Диаметр",
          "original_text": "Бронзовые круги диаметром 30 мм имеют более высокую стоимость по сравнению с аналогичными изделиями меньшего размера, что обусловлено увеличением расхода материала и сложностью обработки.",
          "processed_text": "Бронзовые круги диаметром {prop Диаметр} имеют более высокую стоимость по сравнению с аналогичными изделиями меньшего размера, что обусловлено увеличением расхода материала и сложностью обработки.",
          "html_text": "<p>Бронзовые круги диаметром {prop Диаметр} имеют более высокую стоимость по сравнению с аналогичными изделиями меньшего размера, что обусловлено увеличением расхода материала и сложностью обработки.</p>\n<br>",
          "block_type": "regular",
          "characteristic_name": "Диаметр",
          "characteristic_value": "30",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
