        {
          "id": "char_00007194_полутвердый_1",
          "fragment_name": "Круг_пруток_бронзовый_Состояние_полутвердый",
          "original_text": "Бронзовый круг в полутвердом состоянии демонстрирует оптимальные механические свойства, что способствует увеличению срока службы изделий. Такой уровень твердости позволяет использовать материал в различных условиях эксплуатации.",
          "processed_text": "Бронзовый круг в полутвердом состоянии демонстрирует оптимальные механические свойства, что способствует увеличению срока службы изделий. Такой уровень твердости позволяет использовать материал в различных условиях эксплуатации.",
          "html_text": "<p>Бронзовый круг в полутвердом состоянии демонстрирует оптимальные механические свойства, что способствует увеличению срока службы изделий. Такой уровень твердости позволяет использовать материал в различных условиях эксплуатации.</p>\n<br>",
          "block_type": "unique",
          "characteristic_name": "Состояние",
          "characteristic_value": "полутвердый",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
