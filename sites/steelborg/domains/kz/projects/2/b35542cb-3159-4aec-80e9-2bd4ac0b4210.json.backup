        },
        {
          "id": "char_00004158_тянутый_1",
          "fragment_name": "Круг_пруток_бронзовый_Способ_производства_тянутый",
          "original_text": "Бронзовый кругляк, изготовленный методом вытяжки, отличается высокой однородностью структуры и качеством. Этот процесс обеспечивает равномерное распределение свойств по всей длине изделия, что важно для его применения в различных сферах.",
          "processed_text": "Бронзовый кругляк, изготовленный методом вытяжки, отличается высокой однородностью структуры и качеством. Этот процесс обеспечивает равномерное распределение свойств по всей длине изделия, что важно для его применения в различных сферах.",
          "html_text": "<p>Бронзовый кругляк, изготовленный методом вытяжки, отличается высокой однородностью структуры и качеством. Этот процесс обеспечивает равномерное распределение свойств по всей длине изделия, что важно для его применения в различных сферах.</p>\n<br>",
          "block_type": "unique",
          "characteristic_name": "Способ производства",
          "characteristic_value": "тянутый",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
          "special_symbols": [],
          "last_modified": "2026-07-13T11:30:24.680254"
        },
        {
          "id": "char_00004158_тянутый_2",
          "fragment_name": "Круг_пруток_бронзовый_Способ_производства_тянутый",
          "original_text": "Бронзовые круги изготавливаются методом вытяжки, что влияет на их механические свойства. Учитывание способа производства важно для выбора материала в инженерных решениях, так как это определяет его характеристики и применение.",
          "processed_text": "Бронзовые круги изготавливаются методом вытяжки, что влияет на их механические свойства. Учитывание способа производства важно для выбора материала в инженерных решениях, так как это определяет его характеристики и применение.",
          "html_text": "<p>Бронзовые круги изготавливаются методом вытяжки, что влияет на их механические свойства. Учитывание способа производства важно для выбора материала в инженерных решениях, так как это определяет его характеристики и применение.</p>\n<br>",
          "block_type": "unique",
          "characteristic_name": "Способ производства",
          "characteristic_value": "тянутый",
          "errors": [],
          "manually_fixed": true,
