        },
        {
          "id": "char_00001052_50_1",
          "fragment_name": "Круг_пруток_бронзовый_Диаметр",
          "original_text": "Бронзовый кругляк с диаметром 50 мм отличается повышенной износостойкостью. Увеличение или уменьшение этого параметра может существенно повлиять на срок службы изделий, обеспечивая их эффективность в различных условиях.",
          "processed_text": "Бронзовый кругляк с диаметром {prop Диаметр} отличается повышенной износостойкостью. Увеличение или уменьшение этого параметра может существенно повлиять на срок службы изделий, обеспечивая их эффективность в различных условиях.",
          "html_text": "<p>Бронзовый кругляк с диаметром {prop Диаметр} отличается повышенной износостойкостью. Увеличение или уменьшение этого параметра может существенно повлиять на срок службы изделий, обеспечивая их эффективность в различных условиях.</p>\n<br>",
          "block_type": "regular",
          "characteristic_name": "Диаметр",
          "characteristic_value": "50",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": true,
