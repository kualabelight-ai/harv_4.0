        },
        {
          "id": "char_00001052_50_2",
          "fragment_name": "Круг_пруток_бронзовый_Диаметр",
          "original_text": "Продукция с диаметром 50 мм обладает высокой теплопроводностью и электропроводностью, что делает ее подходящей для различных промышленных применений. Такие характеристики обеспечивают эффективное использование в электротехнической сфере.",
          "processed_text": "Продукция с диаметром {prop Диаметр} обладает высокой теплопроводностью и электропроводностью, что делает ее подходящей для различных промышленных применений. Такие характеристики обеспечивают эффективное использование в электротехнической сфере.",
          "html_text": "<p>Продукция с диаметром {prop Диаметр} обладает высокой теплопроводностью и электропроводностью, что делает ее подходящей для различных промышленных применений. Такие характеристики обеспечивают эффективное использование в электротехнической сфере.</p>\n<br>",
          "block_type": "regular",
          "characteristic_name": "Диаметр",
          "characteristic_value": "50",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": true,
