        },
        {
          "id": "block_new_block_1779779151_16",
          "fragment_name": "Круг_пруток_бронзовый_контроль_качества",
          "original_text": "Допустимые отклонения от нормы для данного изделия включают незначительные дефекты поверхности, такие как мелкие царапины или неровности. Основанием для отбраковки служат значительные деформации, трещины, а также несоответствие заданным размерам.",
          "processed_text": "Допустимые отклонения от нормы для данного изделия включают незначительные дефекты поверхности, такие как мелкие царапины или неровности. Основанием для отбраковки служат значительные деформации, трещины, а также несоответствие заданным размерам.",
          "html_text": "<p>Допустимые отклонения от нормы для данного изделия включают незначительные дефекты поверхности, такие как мелкие царапины или неровности. Основанием для отбраковки служат значительные деформации, трещины, а также несоответствие заданным размерам.</p>\n<br>",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
