        },
        {
          "id": "char_00001052_100_2",
          "fragment_name": "Круг_пруток_бронзовый_Диаметр",
          "original_text": "Бронзовые круги с диаметром 100 мм имеют значительный вес, что влияет на транспортировку и обработку изделий. Увеличение диаметра приводит к росту массы, что важно учитывать при планировании логистики.",
          "processed_text": "Бронзовые круги с диаметром {prop Диаметр} имеют значительный вес, что влияет на транспортировку и обработку изделий. Увеличение диаметра приводит к росту массы, что важно учитывать при планировании логистики.",
          "html_text": "<p>Бронзовые круги с диаметром {prop Диаметр} имеют значительный вес, что влияет на транспортировку и обработку изделий. Увеличение диаметра приводит к росту массы, что важно учитывать при планировании логистики.</p>\n<br>",
          "block_type": "regular",
          "characteristic_name": "Диаметр",
          "characteristic_value": "100",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
