        },
        {
          "id": "char_00001052_100_1",
          "fragment_name": "Круг_пруток_бронзовый_Диаметр",
          "original_text": "Бронзовый кругляк диаметром 100 мм подходит для создания деталей, требующих высокой точности, и его использование в производственных процессах повышает общую эффективность обработки металлов. Такой размер обеспечивает оптимальное сочетание веса и прочности, что важно для механических систем.",
          "processed_text": "Бронзовый кругляк диаметром {prop Диаметр} подходит для создания деталей, требующих высокой точности, и его использование в производственных процессах повышает общую эффективность обработки металлов. Такой размер обеспечивает оптимальное сочетание веса и прочности, что важно для механических систем.",
          "html_text": "<p>Бронзовый кругляк диаметром {prop Диаметр} подходит для создания деталей, требующих высокой точности, и его использование в производственных процессах повышает общую эффективность обработки металлов. Такой размер обеспечивает оптимальное сочетание веса и прочности, что важно для механических систем.</p>\n<br>",
          "block_type": "regular",
          "characteristic_name": "Диаметр",
          "characteristic_value": "100",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
