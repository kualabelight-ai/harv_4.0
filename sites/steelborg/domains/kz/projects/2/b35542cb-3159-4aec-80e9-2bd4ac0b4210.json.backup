        {
          "id": "char_00004158_горячекатаный_2",
          "fragment_name": "Круг_пруток_бронзовый_Способ_производства_горячекатаный",
          "original_text": "Горячекатаные бронзовые круги обладают высокой пластичностью благодаря особенностям технологии производства. Этот метод формирует изделия с улучшенными механическими свойствами, что делает их подходящими для различных применений.",
          "processed_text": "Горячекатаные бронзовые круги обладают высокой пластичностью благодаря особенностям технологии производства. Этот метод формирует изделия с улучшенными механическими свойствами, что делает их подходящими для различных применений.",
          "html_text": "<p>Горячекатаные бронзовые круги обладают высокой пластичностью благодаря особенностям технологии производства. Этот метод формирует изделия с улучшенными механическими свойствами, что делает их подходящими для различных применений.</p>\n<br>",
          "block_type": "unique",
          "characteristic_name": "Способ производства",
          "characteristic_value": "горячекатаный",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
