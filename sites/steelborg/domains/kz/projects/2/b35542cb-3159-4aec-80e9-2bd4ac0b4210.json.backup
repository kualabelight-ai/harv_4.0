        },
        {
          "id": "char_00007194_мягкий_2",
          "fragment_name": "Круг_пруток_бронзовый_Состояние_мягкий",
          "original_text": "Бронзовый кругляк в мягком состоянии демонстрирует высокую пластичность, что позволяет легко обрабатывать материал. Это свойство улучшает механические характеристики, обеспечивая возможность применения в различных отраслях.",
          "processed_text": "Бронзовый кругляк в мягком состоянии демонстрирует высокую пластичность, что позволяет легко обрабатывать материал. Это свойство улучшает механические характеристики, обеспечивая возможность применения в различных отраслях.",
          "html_text": "<p>Бронзовый кругляк в мягком состоянии демонстрирует высокую пластичность, что позволяет легко обрабатывать материал. Это свойство улучшает механические характеристики, обеспечивая возможность применения в различных отраслях.</p>\n<br>",
          "block_type": "unique",
          "characteristic_name": "Состояние",
          "characteristic_value": "мягкий",
          "errors": [],
          "manually_fixed": true,
