        },
        {
          "id": "block_new_block_1779779151_15",
          "fragment_name": "Круг_пруток_бронзовый_контроль_качества",
          "original_text": "Изделие проходит контрольные испытания на механические свойства, коррозионную стойкость, а также химический состав. Эти проверки необходимы для допуска к реализации. Результаты испытаний подтверждают соответствие установленным стандартам качества.",
          "processed_text": "Изделие проходит контрольные испытания на механические свойства, коррозионную стойкость, а также химический состав. Эти проверки необходимы для допуска к реализации. Результаты испытаний подтверждают соответствие установленным стандартам качества.",
          "html_text": "<p>Изделие проходит контрольные испытания на механические свойства, коррозионную стойкость, а также химический состав. Эти проверки необходимы для допуска к реализации. Результаты испытаний подтверждают соответствие установленным стандартам качества.</p>\n<br>",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
