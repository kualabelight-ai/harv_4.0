        {
          "id": "char_00008387_с бетонными захватами_1",
          "fragment_name": "Стропы_цепные_Исполнение_с_бетонными_захватами",
          "original_text": "Грузоподъемные цепные изделия с бетонными захватами упрощают транспортировку и хранение, так как их можно компактно укладывать. Это позволяет экономить пространство и облегчает доступ к оборудованию.",
          "processed_text": "Грузоподъемные цепные изделия с бетонными захватами упрощают транспортировку и хранение, так как их можно компактно укладывать. Это позволяет экономить пространство и облегчает доступ к оборудованию.",
          "html_text": "<p>Грузоподъемные цепные изделия с бетонными захватами упрощают транспортировку и хранение, так как их можно компактно укладывать. Это позволяет экономить пространство и облегчает доступ к оборудованию.</p>\n<br>",
          "block_type": "unique",
          "characteristic_name": "Исполнение",
          "characteristic_value": "с бетонными захватами",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
