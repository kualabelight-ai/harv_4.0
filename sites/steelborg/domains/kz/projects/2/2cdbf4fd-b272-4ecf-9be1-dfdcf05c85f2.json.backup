        },
        {
          "id": "char_00002649_петлевой_2",
          "fragment_name": "Стропы_цепные_Вид_петлевой",
          "original_text": "Петлевая форма стропы цепной способствует равномерному распределению нагрузки, что увеличивает срок службы в сложных условиях эксплуатации. Такой дизайн минимизирует износ, обеспечивая надежную работу при высоких нагрузках.",
          "processed_text": "Петлевая форма стропы цепной способствует равномерному распределению нагрузки, что увеличивает срок службы в сложных условиях эксплуатации. Такой дизайн минимизирует износ, обеспечивая надежную работу при высоких нагрузках.",
          "html_text": "<p>Петлевая форма стропы цепной способствует равномерному распределению нагрузки, что увеличивает срок службы в сложных условиях эксплуатации. Такой дизайн минимизирует износ, обеспечивая надежную работу при высоких нагрузках.</p>\n<br>",
          "block_type": "unique",
          "characteristic_name": "Вид",
          "characteristic_value": "петлевой",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
