        },
        {
          "id": "char_00002649_кольцевой_2",
          "fragment_name": "Стропы_цепные_Вид_кольцевой",
          "original_text": "Кольцевая форма грузоподъемных цепных строп способствует равномерному распределению нагрузки, что уменьшает риск деформаций при эксплуатации. Это позволяет использовать их в различных условиях, обеспечивая высокую устойчивость к механическим воздействиям.",
          "processed_text": "Кольцевая форма грузоподъемных цепных строп способствует равномерному распределению нагрузки, что уменьшает риск деформаций при эксплуатации. Это позволяет использовать их в различных условиях, обеспечивая высокую устойчивость к механическим воздействиям.",
          "html_text": "<p>Кольцевая форма грузоподъемных цепных строп способствует равномерному распределению нагрузки, что уменьшает риск деформаций при эксплуатации. Это позволяет использовать их в различных условиях, обеспечивая высокую устойчивость к механическим воздействиям.</p>\n<br>",
          "block_type": "unique",
          "characteristic_name": "Вид",
          "characteristic_value": "кольцевой",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
