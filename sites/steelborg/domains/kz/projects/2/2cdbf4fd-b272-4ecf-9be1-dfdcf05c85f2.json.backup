        },
        {
          "id": "char_9109695 05_4.25_1",
          "fragment_name": "Стропы_цепные_Грузоподъемность",
          "original_text": "Продукция с грузоподъемностью 4.25 тонны гарантирует высокий уровень безопасности при эксплуатации, что особенно важно в условиях интенсивной работы. Использование таких изделий минимизирует риски и повышает эффективность выполнения задач.",
          "processed_text": "Продукция с грузоподъемностью {prop Грузоподъемность} тонны гарантирует высокий уровень безопасности при эксплуатации, что особенно важно в условиях интенсивной работы. Использование таких изделий минимизирует риски и повышает эффективность выполнения задач.",
          "html_text": "<p>Продукция с грузоподъемностью {prop Грузоподъемность} тонны гарантирует высокий уровень безопасности при эксплуатации, что особенно важно в условиях интенсивной работы. Использование таких изделий минимизирует риски и повышает эффективность выполнения задач.</p>\n<br>",
          "block_type": "regular",
          "characteristic_name": "Грузоподъемность",
          "characteristic_value": "4.25",
          "errors": [],
