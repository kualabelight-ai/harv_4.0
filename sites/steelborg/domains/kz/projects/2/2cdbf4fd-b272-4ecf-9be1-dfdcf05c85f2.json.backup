        },
        {
          "id": "char_00008387_с бетонными захватами_2",
          "fragment_name": "Стропы_цепные_Исполнение_с_бетонными_захватами",
          "original_text": "Изделие выполнено из высококачественной стали, что позволяет ему выдерживать значительные нагрузки. Бетонные захваты увеличивают срок службы в сложных условиях, обеспечивая надежное соединение и минимизируя риск повреждений.",
          "processed_text": "Изделие выполнено из высококачественной стали, что позволяет ему выдерживать значительные нагрузки. Бетонные захваты увеличивают срок службы в сложных условиях, обеспечивая надежное соединение и минимизируя риск повреждений.",
          "html_text": "<p>Изделие выполнено из высококачественной стали, что позволяет ему выдерживать значительные нагрузки. Бетонные захваты увеличивают срок службы в сложных условиях, обеспечивая надежное соединение и минимизируя риск повреждений.</p>\n<br>",
          "block_type": "unique",
          "characteristic_name": "Исполнение",
          "characteristic_value": "с бетонными захватами",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
