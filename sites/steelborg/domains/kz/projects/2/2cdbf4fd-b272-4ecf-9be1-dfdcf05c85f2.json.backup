        },
        {
          "id": "char_9109695 05_11.2_1",
          "fragment_name": "Стропы_цепные_Грузоподъемность",
          "original_text": "Грузоподъемные цепные стропы имеют максимальную нагрузку 11.2 тонны, что соответствует строгим нормам безопасности. Их использование гарантирует надежное перемещение тяжелых объектов на строительных площадках и в производственных условиях.",
          "processed_text": "Грузоподъемные цепные стропы имеют максимальную нагрузку {prop Грузоподъемность} тонны, что соответствует строгим нормам безопасности. Их использование гарантирует надежное перемещение тяжелых объектов на строительных площадках и в производственных условиях.",
          "html_text": "<p>Грузоподъемные цепные стропы имеют максимальную нагрузку {prop Грузоподъемность} тонны, что соответствует строгим нормам безопасности. Их использование гарантирует надежное перемещение тяжелых объектов на строительных площадках и в производственных условиях.</p>\n<br>",
          "block_type": "regular",
          "characteristic_name": "Грузоподъемность",
          "characteristic_value": "11.2",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": true,
          "added_value": "11.2",
