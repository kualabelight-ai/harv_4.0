        {
          "id": "block_new_block_1779779413_6",
          "fragment_name": "Стропы_цепные_хранение_товара",
          "original_text": "Для защиты от повреждений изделие упаковывают в пленку или картонные коробки. Хранение в сухом месте с контролем температуры также помогает сохранить его в хорошем состоянии.",
          "processed_text": "Для защиты от повреждений изделие упаковывают в пленку или картонные коробки. Хранение в сухом месте с контролем температуры также помогает сохранить его в хорошем состоянии.",
          "html_text": "<p>Для защиты от повреждений изделие упаковывают в пленку или картонные коробки. Хранение в сухом месте с контролем температуры также помогает сохранить его в хорошем состоянии.</p>\n<br>",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
          "special_symbols": [],
