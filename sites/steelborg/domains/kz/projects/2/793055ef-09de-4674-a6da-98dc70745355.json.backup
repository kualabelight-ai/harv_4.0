            "объем_требование": {
              "name": "объем_требование",
              "description": "Ограничения по объему и количеству предложений",
              "values": [
                "1–3 предложения, 150–250 символов без пробелов",
                "2–3 предложения, 150–200 символов",
                "200–300 символов без пробелов",
                "2 предложения, 150–180 символов без пробелов",
