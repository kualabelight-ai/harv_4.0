            },
            "описание_вступление_ai": {
              "name": "описание_вступление_ai",
              "description": "AI переменная: описание_вступление_ai",
              "type": "ai",
              "ai_prompt": "Сгенерируй строгий линейный перечень из 30 пунктов. Каждый пункт ДОЛЖЕН быть:\n1. Глагол в повелительном наклонении + фраза с автоматической вставкой категории \"{категория}\"\n2. Категория \"{категория}\" должна быть упомянута в каждом пункте\n3. Фокус ТОЛЬКО на ОБЩЕЙ, ВВОДНОЙ ИНФОРМАЦИИ: что это, базовая суть, общее определение\n4. НЕ включать аспекты: \"характеристики\", \"свойства\", \"применение\", \"использование\", \"производство\", \"монтаж\", \"эксплуатация\"\n5. Разделитель ТОЛЬКО \";\" без пробелов после\n6. Без номеров, маркеров, пояснений\n7. Конец последнего пункта - \";\"\n\nФормат вывода ТОЧНО такой:\nГлагол[пробел]текст[категория][текст];\n\nПример для категории \"двутавр\":\nДать общее определение двутавра;Что такое двутавр;Объясни базовую суть двутавра;Кратко расскажи что из себя представляет двутавр;Опиши что такое двутавр в двух словах;Сформулируй общее понятие двутавра;Дать краткую общую информацию о двутавре;Что собой представляет двутавр;Объясни что такое двутавр;Общее определение двутавра;\n\nКатегория:{категория}",
              "ai_num_variants": 1,
              "ai_provider": "agentplatform",
              "values": [],
              "ai_model": "gpt-4o-mini"
            },
            "описание_требование_ai": {
              "name": "описание_требование_ai",
              "description": "AI переменная: описание_требование_ai",
              "type": "ai",
              "ai_prompt": "Сгенерируй строгий линейный перечень из 30 пунктов. Каждый пункт ДОЛЖЕН быть:\n1. Глагол в повелительном наклонении + фраза\n2. Фокус на СУТИ объекта, но и на информации, полезной для покупателя/пользователя\n3. Допустимые темы: геометрия, конструкция, материальная основа, физическая форма, внутреннее строение\n4. ЗАПРЕЩЕНО включать: применение, использование, производство, ассортимент, типоразмеры, маркировку, нормативы\n5. Разделитель ТОЛЬКО \";\" без пробелов после знака\n6. Без номеров, маркеров, пояснений\n7. Конец последнего пункта - \";\"\n\nФормат вывода ТОЧНО такой:\nГлагол[пробел]текст[текст];\n\nПример для категории \"двутавр\":\nОпиши геометрическую форму;Объясни конструктивную схему;Охарактеризуй материальную основу;Опиши физическое строение;Объясни принцип распределения массы;Охарактеризуй пространственную структуру;Опиши базовый конструктивный принцип;Объясни суть формы;Охарактеризуй физическую природу\n\nКатегория: {категория}",
              "ai_num_variants": 1,
              "ai_provider": "agentplatform",
              "ai_context_type": "other",
              "ai_model": "gpt-4o-mini"
            },
