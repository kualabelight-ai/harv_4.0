        },
        {
          "id": "text_35",
          "fragment_name": "Круг_пруток_алюминиевый_Марка_материала",
          "original_text": "Марка Д16 характеризуется высокой прочностью и отличной коррозионной стойкостью, что положительно сказывается на механических свойствах алюминиевого круга. Использование этого сплава позволяет добиться улучшенных эксплуатационных характеристик в различных условиях.",
          "processed_text": "Марка {prop Марка материала} характеризуется высокой прочностью и отличной коррозионной стойкостью, что положительно сказывается на механических свойствах алюминиевого круга. Использование этого сплава позволяет добиться улучшенных эксплуатационных характеристик в различных условиях.",
          "html_text": "<p>Марка {prop Марка материала} характеризуется высокой прочностью и отличной коррозионной стойкостью, что положительно сказывается на механических свойствах алюминиевого круга. Использование этого сплава позволяет добиться улучшенных эксплуатационных характеристик в различных условиях.</p>\n<br>",
          "block_type": "regular",
          "characteristic_name": "Марка материала",
          "characteristic_value": "Д16",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
