          "last_modified": "2026-07-03T11:38:49.631530"
        },
        {
          "id": "text_48",
          "fragment_name": "Круг_пруток_алюминиевый_Марка_материала",
          "original_text": "Круг из алюминия марки АК6, благодаря своим характеристикам, подходит для использования в условиях умеренных температур и влажности. Этот материал часто применяется в строительстве, а также в производстве деталей для транспортных средств.",
          "processed_text": "Круг из алюминия марки {prop Марка материала}, благодаря своим характеристикам, подходит для использования в условиях умеренных температур и влажности. Этот материал часто применяется в строительстве, а также в производстве деталей для транспортных средств.",
          "html_text": "<p>Круг из алюминия марки {prop Марка материала}, благодаря своим характеристикам, подходит для использования в условиях умеренных температур и влажности. Этот материал часто применяется в строительстве, а также в производстве деталей для транспортных средств.</p>\n<br>",
          "block_type": "regular",
          "characteristic_name": "Марка материала",
          "characteristic_value": "АК6",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": true,
          "added_value": "АК6",
