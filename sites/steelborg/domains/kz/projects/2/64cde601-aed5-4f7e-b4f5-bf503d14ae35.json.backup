        },
        {
          "id": "text_42",
          "fragment_name": "Круг_пруток_алюминиевый_Марка_материала",
          "original_text": "Марка В95Т1 демонстрирует высокую устойчивость к нагрузкам и деформациям, что делает ее предпочтительной для ответственных конструкций. Алюминиевые круги из этой серии превосходят по характеристикам другие марки, обеспечивая надежную эксплуатацию в различных условиях.",
          "processed_text": "Марка {prop Марка материала} демонстрирует высокую устойчивость к нагрузкам и деформациям, что делает ее предпочтительной для ответственных конструкций. Алюминиевые круги из этой серии превосходят по характеристикам другие марки, обеспечивая надежную эксплуатацию в различных условиях.",
          "html_text": "<p>Марка {prop Марка материала} демонстрирует высокую устойчивость к нагрузкам и деформациям, что делает ее предпочтительной для ответственных конструкций. Алюминиевые круги из этой серии превосходят по характеристикам другие марки, обеспечивая надежную эксплуатацию в различных условиях.</p>\n<br>",
          "block_type": "regular",
          "characteristic_name": "Марка материала",
          "characteristic_value": "В95Т1",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": true,
          "added_value": "В95Т1",
