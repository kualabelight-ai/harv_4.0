        },
        {
          "id": "text_40",
          "fragment_name": "Круг_пруток_алюминиевый_Марка_материала",
          "original_text": "Продукция марки В95Т1 подходит для обработки и сварки благодаря своей высокой пластичности и хорошей свариваемости, что делает ее востребованной в различных отраслях.",
          "processed_text": "Продукция марки {prop Марка материала} подходит для обработки и сварки благодаря своей высокой пластичности и хорошей свариваемости, что делает ее востребованной в различных отраслях.",
          "html_text": "<p>Продукция марки {prop Марка материала} подходит для обработки и сварки благодаря своей высокой пластичности и хорошей свариваемости, что делает ее востребованной в различных отраслях.</p>\n<br>",
          "block_type": "regular",
          "characteristic_name": "Марка материала",
          "characteristic_value": "В95Т1",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": true,
          "added_value": "В95Т1",
          "special_symbols": [],
