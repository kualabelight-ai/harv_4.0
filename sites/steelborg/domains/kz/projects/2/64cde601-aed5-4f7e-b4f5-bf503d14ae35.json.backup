        },
        {
          "id": "text_85",
          "fragment_name": "Круг_пруток_алюминиевый_описание",
          "original_text": "Круг из алюминия представляет собой цилиндрический профиль, используемый в строительстве и производстве. Хранить его следует в сухом помещении, защищенном от влаги и прямых солнечных лучей. Это поможет избежать коррозии и сохранить свойства материала.",
          "processed_text": "Круг из алюминия представляет собой цилиндрический профиль, используемый в строительстве и производстве. Хранить его следует в сухом помещении, защищенном от влаги и прямых солнечных лучей. Это поможет избежать коррозии и сохранить свойства материала.",
          "html_text": "<p>Круг из алюминия представляет собой цилиндрический профиль, используемый в строительстве и производстве. Хранить его следует в сухом помещении, защищенном от влаги и прямых солнечных лучей. Это поможет избежать коррозии и сохранить свойства материала.</p>\n<br>",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
