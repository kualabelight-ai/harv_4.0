        },
        {
          "id": "text_27",
          "fragment_name": "Круг_пруток_алюминиевый_Марка_материала",
          "original_text": "Изделие из алюминиевого сплава марки Д16Т подходит для использования в условиях повышенных нагрузок, благодаря высокой стойкости к коррозии и механическим повреждениям. Это делает его идеальным выбором для авиационной и автомобильной промышленности.",
          "processed_text": "Изделие из алюминиевого сплава марки {prop Марка материала} подходит для использования в условиях повышенных нагрузок, благодаря высокой стойкости к коррозии и механическим повреждениям. Это делает его подходящим выбором для авиационной и автомобильной промышленности.",
          "html_text": "<p>Изделие из алюминиевого сплава марки {prop Марка материала} подходит для использования в условиях повышенных нагрузок, благодаря высокой стойкости к коррозии и механическим повреждениям. Это делает его подходящим выбором для авиационной и автомобильной промышленности.</p>\n<br>",
          "block_type": "regular",
          "characteristic_name": "Марка материала",
          "characteristic_value": "Д16Т",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": true,
          "added_value": "Д16Т",
