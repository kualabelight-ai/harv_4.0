        },
        {
          "id": "char_9113676 05_крешерная_1",
          "fragment_name": "Проволока_медная_Вид_крешерная",
          "original_text": "Продукция из меди с крешерной характеристикой подходит для сварки и соединения проводников, обеспечивая стабильный контакт. Выбор данного вида влияет на качество соединений, улучшая электрическую проводимость.",
          "processed_text": "Продукция из меди с крешерной характеристикой подходит для сварки и соединения проводников, обеспечивая стабильный контакт. Выбор данного вида влияет на качество соединений, улучшая электрическую проводимость.",
          "html_text": "<p>Продукция из меди с крешерной характеристикой подходит для сварки и соединения проводников, обеспечивая стабильный контакт. Выбор данного вида влияет на качество соединений, улучшая электрическую проводимость.</p>\n<br>",
          "block_type": "unique",
          "characteristic_name": "Вид",
          "characteristic_value": "крешерная",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
