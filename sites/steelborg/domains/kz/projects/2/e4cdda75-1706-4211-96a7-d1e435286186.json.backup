        },
        {
          "id": "block_new_block_1779778598_5",
          "fragment_name": "Проволока_медная_разновидности",
          "original_text": "Виды данного изделия определяют его функциональные возможности, а также сферы применения. Продукция используется в электротехнике, строительстве, производстве и других отраслях благодаря своим характеристикам.",
          "processed_text": "Виды данного изделия определяют его функциональные возможности, а также сферы применения. Продукция используется в электротехнике, строительстве, производстве и других отраслях благодаря своим характеристикам.",
          "html_text": "<p>Виды данного изделия определяют его функциональные возможности, а также сферы применения. Продукция используется в электротехнике, строительстве, производстве и других отраслях благодаря своим характеристикам.</p>\n<br>",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
