          "last_modified": "2026-07-03T17:26:23.107823"
        },
        {
          "id": "char_9113676 03_электротехническая_4",
          "fragment_name": "Проволока_медная_Назначение_электротехническая",
          "original_text": "Изделие применяется в электротехнических системах благодаря высокой проводимости. Выбор сечения зависит от нагрузки и длины проводки, что влияет на эффективность работы оборудования.",
          "processed_text": "Изделие применяется в электротехнических системах благодаря высокой проводимости. Выбор сечения зависит от нагрузки и длины проводки, что влияет на эффективность работы оборудования.",
          "html_text": "<p>Изделие применяется в электротехнических системах благодаря высокой проводимости. Выбор сечения зависит от нагрузки и длины проводки, что влияет на эффективность работы оборудования.</p>\n<br>",
          "block_type": "unique",
          "characteristic_name": "Назначение",
          "characteristic_value": "электротехническая",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
