        {
          "id": "block_new_block_1779779413_5",
          "fragment_name": "Проволока_медная_хранение_товара",
          "original_text": "Для защиты изделия от повреждений используйте жесткие коробки или рулоны с защитной пленкой. Храните проволоку медную в сухом месте, избегая воздействия влаги и прямых солнечных лучей.",
          "processed_text": "Для защиты изделия от повреждений используйте жесткие коробки или рулоны с защитной пленкой. Храните проволоку медную в сухом месте, избегая воздействия влаги и прямых солнечных лучей.",
          "html_text": "<p>Для защиты изделия от повреждений используйте жесткие коробки или рулоны с защитной пленкой. Храните проволоку медную в сухом месте, избегая воздействия влаги и прямых солнечных лучей.</p>\n<br>",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": false,
