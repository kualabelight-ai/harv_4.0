        },
        {
          "id": "block_new_block_1779778817_10",
          "fragment_name": "Проволока_медная_подбор",
          "original_text": "При выборе данного изделия часто допускают ошибки, связанные с неправильным определением сечения и материала. Неверный расчет может привести к перегреву или повреждению. Проволоки медные должны соответствовать требованиям конкретного проекта для обеспечения эффективной работы.",
          "processed_text": "При выборе данного изделия часто допускают ошибки, связанные с неправильным определением сечения и материала. Неверный расчет может привести к перегреву или повреждению. Проволоки медные должны соответствовать требованиям конкретного проекта для обеспечения эффективной работы.",
          "html_text": "<p>При выборе данного изделия часто допускают ошибки, связанные с неправильным определением сечения и материала. Неверный расчет может привести к перегреву или повреждению. Проволоки медные должны соответствовать требованиям конкретного проекта для обеспечения эффективной работы.</p>\n<br>",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
