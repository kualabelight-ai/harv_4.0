        },
        {
          "id": "char_9113676 03_электротехническая_3",
          "fragment_name": "Проволока_медная_Назначение_электротехническая",
          "original_text": "Медная продукция используется в электротехнической сфере для создания проводов и кабелей, а также в системах заземления. В зависимости от назначения, она может варьироваться по сечению и изоляции, что влияет на эффективность передачи тока.",
          "processed_text": "Медная продукция используется в электротехнической сфере для создания проводов и кабелей, а также в системах заземления. В зависимости от назначения, она может варьироваться по сечению и изоляции, что влияет на эффективность передачи тока.",
          "html_text": "<p>Медная продукция используется в электротехнической сфере для создания проводов и кабелей, а также в системах заземления. В зависимости от назначения, она может варьироваться по сечению и изоляции, что влияет на эффективность передачи тока.</p>\n<br>",
          "block_type": "unique",
          "characteristic_name": "Назначение",
          "characteristic_value": "электротехническая",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
