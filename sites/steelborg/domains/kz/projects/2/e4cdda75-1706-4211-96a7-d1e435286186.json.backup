        },
        {
          "id": "char_9113676 06_круглая_1",
          "fragment_name": "Проволока_медная_Форма_круглая",
          "original_text": "Круглая форма изделия способствует высокой электрической проводимости, что делает продукцию эффективной для использования в различных электрических системах. Такой профиль минимизирует сопротивление, обеспечивая оптимальную передачу энергии.",
          "processed_text": "Круглая форма изделия способствует высокой электрической проводимости, что делает продукцию эффективной для использования в различных электрических системах. Такой профиль минимизирует сопротивление, обеспечивая оптимальную передачу энергии.",
          "html_text": "<p>Круглая форма изделия способствует высокой электрической проводимости, что делает продукцию эффективной для использования в различных электрических системах. Такой профиль минимизирует сопротивление, обеспечивая оптимальную передачу энергии.</p>\n<br>",
          "block_type": "unique",
          "characteristic_name": "Форма",
          "characteristic_value": "круглая",
          "errors": [],
