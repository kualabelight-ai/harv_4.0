        },
        {
          "id": "block_new_block_1779779151_13",
          "fragment_name": "Проволока_медная_контроль_качества",
          "original_text": "При визуальном контроле изделия проверяют на наличие дефектов, а также соответствие стандартам. Если возникают сомнения в качестве, часть партии направляют на испытания для дополнительной оценки.",
          "processed_text": "При визуальном контроле изделия проверяют на наличие дефектов, а также соответствие стандартам. Если возникают сомнения в качестве, часть партии направляют на испытания для дополнительной оценки.",
          "html_text": "<p>При визуальном контроле изделия проверяют на наличие дефектов, а также соответствие стандартам. Если возникают сомнения в качестве, часть партии направляют на испытания для дополнительной оценки.</p>\n<br>",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
