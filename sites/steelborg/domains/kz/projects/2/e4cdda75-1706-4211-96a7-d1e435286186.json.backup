        },
        {
          "id": "char_00001134_1.5_2",
          "fragment_name": "Проволока_медная_Диаметр",
          "original_text": "При диаметре 1.5 мм медная проволока требует дополнительных защитных мер в агрессивных средах, так как повышенная коррозия может снизить ее функциональность и срок службы. Использование защитных покрытий или изоляции поможет избежать негативного воздействия внешней среды.",
          "processed_text": "При диаметре 1.5 мм медная проволока требует дополнительных защитных мер в агрессивных средах, так как повышенная коррозия может снизить ее функциональность и срок службы. Использование защитных покрытий или изоляции поможет избежать негативного воздействия внешней среды.",
          "html_text": "<p>При диаметре {prop Диаметр} медная проволока требует дополнительных защитных мер в агрессивных средах, так как повышенная коррозия может снизить ее функциональность и срок службы. Использование защитных покрытий или изоляции поможет избежать негативного воздействия внешней среды.</p>\n<br>",
          "block_type": "regular",
          "characteristic_name": "Диаметр",
          "characteristic_value": "1.5",
          "errors": [],
          "manually_fixed": true,
          "warnings": [],
          "status": "fixed",
