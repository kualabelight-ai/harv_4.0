        },
        {
          "id": "char_9112167 06_закаленная_1",
          "fragment_name": "Труба_алюминиевая_Состояние_закаленная",
          "original_text": "Закаленная продукция демонстрирует высокую устойчивость к температурным колебаниям, что позволяет ей сохранять форму и функциональность даже при экстремальных условиях. Это свойство делает материал подходящим для применения в различных отраслях.",
          "processed_text": "Закаленная продукция демонстрирует высокую устойчивость к температурным колебаниям, что позволяет ей сохранять форму и функциональность даже при экстремальных условиях. Это свойство делает материал подходящим для применения в различных отраслях.",
          "html_text": "",
          "block_type": "unique",
          "characteristic_name": "Состояние",
          "characteristic_value": "закаленная",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
          "status": "processed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
          "special_symbols": [],
          "last_modified": "2026-07-03T10:57:26.885905"
        },
        {
          "id": "char_9112167 06_закаленная_2",
          "fragment_name": "Труба_алюминиевая_Состояние_закаленная",
          "original_text": "Закаленные изделия из алюминия обладают высокой стойкостью к механическим повреждениям. При работе с ними важно использовать защитные перчатки и очки для предотвращения травм.",
          "processed_text": "Закаленные изделия из алюминия обладают высокой стойкостью к механическим повреждениям. При работе с ними важно использовать защитные перчатки и очки для предотвращения травм.",
          "html_text": "",
          "block_type": "unique",
          "characteristic_name": "Состояние",
          "characteristic_value": "закаленная",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
          "status": "processed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
          "special_symbols": [],
          "last_modified": "2026-07-03T10:57:26.885905"
        },
        {
          "id": "char_9112167 06_закаленная_3",
          "fragment_name": "Труба_алюминиевая_Состояние_закаленная",
          "original_text": "Закаленная конструкция из алюминия улучшает процесс сварки, позволяя создавать более прочные соединения. Это свойство делает материал подходящим для различных промышленных применений.",
          "processed_text": "Закаленная конструкция из алюминия улучшает процесс сварки, позволяя создавать более прочные соединения. Это свойство делает материал подходящим для различных промышленных применений.",
          "html_text": "",
          "block_type": "unique",
          "characteristic_name": "Состояние",
          "characteristic_value": "закаленная",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
          "status": "processed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
          "special_symbols": [],
          "last_modified": "2026-07-03T10:57:26.885905"
        },
        {
          "id": "char_9112167 06_закаленная_4",
          "fragment_name": "Труба_алюминиевая_Состояние_закаленная",
          "original_text": "Закаленное изделие демонстрирует повышенные механические свойства, что позволяет ему выдерживать значительные нагрузки. Это состояние улучшает сопротивление к деформации, увеличивая срок службы в различных условиях эксплуатации.",
          "processed_text": "Закаленное изделие демонстрирует повышенные механические свойства, что позволяет ему выдерживать значительные нагрузки. Это состояние улучшает сопротивление к деформации, увеличивая срок службы в различных условиях эксплуатации.",
          "html_text": "",
          "block_type": "unique",
          "characteristic_name": "Состояние",
          "characteristic_value": "закаленная",
          "errors": [],
          "manually_fixed": false,
