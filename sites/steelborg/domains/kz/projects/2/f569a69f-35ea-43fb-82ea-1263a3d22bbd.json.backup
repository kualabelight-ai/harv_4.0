        },
        {
          "id": "char_9112167 03_заготовка_1",
          "fragment_name": "Труба_алюминиевая_Вид_заготовка",
          "original_text": "Продукция из легкого металла обладает высокой коррозионной стойкостью благодаря специальной обработке поверхности. Такой выбор гарантирует длительный срок службы в различных условиях эксплуатации.",
          "processed_text": "Продукция из легкого металла обладает высокой коррозионной стойкостью благодаря специальной обработке поверхности. Такой выбор гарантирует длительный срок службы в различных условиях эксплуатации.",
          "html_text": "",
          "block_type": "unique",
          "characteristic_name": "Вид",
          "characteristic_value": "заготовка",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
          "status": "processed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
          "special_symbols": [],
          "last_modified": "2026-07-03T10:57:26.885905"
        },
        {
          "id": "char_9112167 03_заготовка_2",
          "fragment_name": "Труба_алюминиевая_Вид_заготовка",
          "original_text": "Алюминиевые трубы, изготовленные из сплавов с высоким содержанием магния, обладают улучшенными механическими свойствами. Такой вид заготовки способствует повышению коррозионной стойкости и снижению веса изделий, что делает их более удобными в использовании.",
          "processed_text": "Алюминиевые трубы, изготовленные из сплавов с высоким содержанием магния, обладают улучшенными механическими свойствами. Такой вид заготовки способствует повышению коррозионной стойкости и снижению веса изделий, что делает их более удобными в использовании.",
          "html_text": "",
          "block_type": "unique",
          "characteristic_name": "Вид",
          "characteristic_value": "заготовка",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
          "status": "processed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
          "special_symbols": [],
          "last_modified": "2026-07-03T10:57:26.885905"
        },
        {
          "id": "char_9112167 03_заготовка_3",
          "fragment_name": "Труба_алюминиевая_Вид_заготовка",
          "original_text": "Изделие из легкого металла обладает высокой прочностью при малом весе, что упрощает транспортировку и монтаж. Трубы из алюминия обеспечивают отличные эксплуатационные характеристики благодаря своей конструкции.",
          "processed_text": "Изделие из легкого металла обладает высокой прочностью при малом весе, что упрощает транспортировку и монтаж. Трубы из алюминия обеспечивают отличные эксплуатационные характеристики благодаря своей конструкции.",
          "html_text": "",
          "block_type": "unique",
          "characteristic_name": "Вид",
          "characteristic_value": "заготовка",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
          "status": "processed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
          "special_symbols": [],
          "last_modified": "2026-07-03T10:57:26.885905"
        },
        {
          "id": "char_9112167 03_заготовка_4",
          "fragment_name": "Труба_алюминиевая_Вид_заготовка",
          "original_text": "Выбор вида заготовки влияет на сроки производства и поставки. Например, труба из алюминия с определенными характеристиками позволяет сократить время обработки и ускорить доставку готовой продукции.",
          "processed_text": "Выбор вида заготовки влияет на сроки производства и поставки. Например, труба из алюминия с определенными характеристиками позволяет сократить время обработки и ускорить доставку готовой продукции.",
          "html_text": "",
          "block_type": "unique",
          "characteristic_name": "Вид",
          "characteristic_value": "заготовка",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
