        },
        {
          "id": "block_description_template_10",
          "fragment_name": "Труба_алюминиевая_описание",
          "original_text": "Алюминиевая труба обладает легким весом и высокой коррозионной стойкостью. Она имеет гладкую поверхность, что упрощает монтаж и снижает трение при транспортировке жидкостей. Внутренний диаметр может варьироваться, позволяя использовать изделие в различных системах. Такой материал часто применяется в строительстве, автомобилестроении и производстве мебели.",
          "processed_text": "Алюминиевая труба обладает легким весом и высокой коррозионной стойкостью. Она имеет гладкую поверхность, что упрощает монтаж и снижает трение при транспортировке жидкостей. Внутренний диаметр может варьироваться, позволяя использовать изделие в различных системах. Такой материал часто применяется в строительстве, автомобилестроении и производстве мебели.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
