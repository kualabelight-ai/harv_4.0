          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
          "special_symbols": [],
          "last_modified": "2026-07-03T10:57:26.885905"
        },
        {
          "id": "char_9112167 03_заготовка_5",
          "fragment_name": "Труба_алюминиевая_Вид_заготовка",
          "original_text": "Алюминиевая труба с определенным видом заготовки позволяет добиться качественных сварных соединений, так как ее форма способствует лучшему сцеплению. Это особенно важно для создания прочных конструкций, где требуется высокая степень надежности соединений.",
          "processed_text": "Алюминиевая труба с определенным видом заготовки позволяет добиться качественных сварных соединений, так как ее форма способствует лучшему сцеплению. Это особенно важно для создания прочных конструкций, где требуется высокая степень надежности соединений.",
          "html_text": "",
          "block_type": "unique",
          "characteristic_name": "Вид",
          "characteristic_value": "заготовка",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
          "status": "processed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
          "special_symbols": [],
          "last_modified": "2026-07-03T10:57:26.885905"
        },
        {
          "id": "char_9112167 03_заготовка_6",
          "fragment_name": "Труба_алюминиевая_Вид_заготовка",
          "original_text": "Алюминиевая заготовка отличается легкостью и высокой коррозионной стойкостью, что делает изделие востребованным в различных отраслях. Вид материала влияет на стоимость, так как более сложные формы требуют дополнительных затрат на обработку.",
          "processed_text": "Алюминиевая заготовка отличается легкостью и высокой коррозионной стойкостью, что делает изделие востребованным в различных отраслях. Вид материала влияет на стоимость, так как более сложные формы требуют дополнительных затрат на обработку.",
          "html_text": "",
          "block_type": "unique",
          "characteristic_name": "Вид",
          "characteristic_value": "заготовка",
          "errors": [],
