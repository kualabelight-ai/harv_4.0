        },
        {
          "id": "char_9112167 06_отожженная_4",
          "fragment_name": "Труба_алюминиевая_Состояние_отожженная",
          "original_text": "Отожженные изделия из алюминия имеют повышенную устойчивость к коррозии, что увеличивает срок службы в агрессивных средах. Такие трубы из алюминия подходят для применения в сложных условиях эксплуатации.",
          "processed_text": "Отожженные изделия из алюминия имеют повышенную устойчивость к коррозии, что увеличивает срок службы в агрессивных средах. Такие трубы из алюминия подходят для применения в сложных условиях эксплуатации.",
          "html_text": "",
          "block_type": "unique",
          "characteristic_name": "Состояние",
          "characteristic_value": "отожженная",
