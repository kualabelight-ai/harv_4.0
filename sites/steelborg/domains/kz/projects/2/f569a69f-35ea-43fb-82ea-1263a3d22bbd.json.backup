        },
        {
          "id": "block_new_block_1779779413_2",
          "fragment_name": "Труба_алюминиевая_хранение_товара",
          "original_text": "Алюминиевая труба упаковывается в защитные пленки или картонные коробки. Хранение в сухом помещении с минимальным воздействием влаги предотвращает механические повреждения.",
          "processed_text": "Алюминиевая труба упаковывается в защитные пленки или картонные коробки. Хранение в сухом помещении с минимальным воздействием влаги предотвращает механические повреждения.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
