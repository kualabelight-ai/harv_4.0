        },
        {
          "id": "block_new_block_1779778817_8",
          "fragment_name": "Труба_алюминиевая_подбор",
          "original_text": "Алюминиевая конструкция подходит для использования в строительстве, автомобилестроении и производстве. При выборе изделия стоит обратиться к эксперту, если необходимы специфические размеры или особые условия эксплуатации. Также консультация поможет определить подходящий сплав для конкретной задачи.",
          "processed_text": "Алюминиевая конструкция подходит для использования в строительстве, автомобилестроении и производстве. При выборе изделия стоит обратиться к эксперту, если необходимы специфические размеры или особые условия эксплуатации. Также консультация поможет определить подходящий сплав для конкретной задачи.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
