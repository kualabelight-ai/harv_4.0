        },
        {
          "id": "block_new_block_1779778327_15",
          "fragment_name": "Труба_алюминиевая_преимущества",
          "original_text": "Продукция из алюминия снижает затраты на транспортировку и монтаж благодаря легкости. Использование таких изделий в проекте позволяет оптимизировать расходы, что способствует повышению общей экономической эффективности. Это решение подходит для различных областей применения.",
          "processed_text": "Продукция из алюминия снижает затраты на транспортировку и монтаж благодаря легкости. Использование таких изделий в проекте позволяет оптимизировать расходы, что способствует повышению общей экономической эффективности. Это решение подходит для различных областей применения.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
