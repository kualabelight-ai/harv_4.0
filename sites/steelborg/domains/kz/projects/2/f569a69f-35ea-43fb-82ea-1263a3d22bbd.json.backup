        },
        {
          "id": "block_new_block_1779776713_16",
          "fragment_name": "Труба_алюминиевая_свойства",
          "original_text": "Алюминиевые трубы имеют легкий вес, устойчивы к коррозии, а также отличаются высокой теплопроводностью. Доступны в различных диаметрах и длинах, что позволяет выбрать оптимальный вариант для конкретных задач.",
          "processed_text": "Алюминиевые трубы имеют легкий вес, устойчивы к коррозии, а также отличаются высокой теплопроводностью. Доступны в различных диаметрах и длинах, что позволяет выбрать оптимальный вариант для конкретных задач.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
