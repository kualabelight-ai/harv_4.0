        },
        {
          "id": "block_new_block_1779778598_16",
          "fragment_name": "Труба_алюминиевая_разновидности",
          "original_text": "Сортамент продукции формируется на основе таких параметров, как диаметр, толщина стенки и длина. Эти характеристики позволяют выбрать подходящий вариант для различных применений. Организация сортамента учитывает требования к весу, прочности и устойчивости к коррозии, что делает изделия востребованными в разных отраслях.",
          "processed_text": "Сортамент продукции формируется на основе таких параметров, как диаметр, толщина стенки и длина. Эти характеристики позволяют выбрать подходящий вариант для различных применений. Организация сортамента учитывает требования к весу, прочности и устойчивости к коррозии, что делает изделия востребованными в разных отраслях.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
          "status": "processed",
          "manual_correction": null,
          "auto_corrected": false,
