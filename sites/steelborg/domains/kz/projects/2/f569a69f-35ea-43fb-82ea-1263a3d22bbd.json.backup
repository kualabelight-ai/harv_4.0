        },
        {
          "id": "block_new_block_1779778327_14",
          "fragment_name": "Труба_алюминиевая_преимущества",
          "original_text": "Алюминиевые изделия легкие и устойчивые к коррозии. Трубы из алюминия подходят для различных условий эксплуатации, обеспечивая простоту монтажа и длительный срок службы.",
          "processed_text": "Алюминиевые изделия легкие и устойчивые к коррозии. Трубы из алюминия подходят для различных условий эксплуатации, обеспечивая простоту монтажа и длительный срок службы.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
