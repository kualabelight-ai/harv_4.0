        },
        {
          "id": "block_description_template_6",
          "fragment_name": "Труба_алюминиевая_описание",
          "original_text": "Алюминиевая конструкция используется в строительстве благодаря легкости и устойчивости к коррозии. Масса распределяется равномерно, что позволяет снизить нагрузку на опоры и улучшить общую стабильность.",
          "processed_text": "Алюминиевая конструкция используется в строительстве благодаря легкости и устойчивости к коррозии. Масса распределяется равномерно, что позволяет снизить нагрузку на опоры и улучшить общую стабильность.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
