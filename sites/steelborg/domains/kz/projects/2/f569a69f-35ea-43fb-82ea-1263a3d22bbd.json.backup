        },
        {
          "id": "char_9112167 06_нагартованная_5",
          "fragment_name": "Труба_алюминиевая_Состояние_нагартованная",
          "original_text": "Нагартованная конструкция из алюминия обладает высокой устойчивостью к механическим повреждениям, что упрощает монтаж и обработку. Такой параметр позволяет использовать материал в различных условиях, обеспечивая надежное соединение элементов.",
          "processed_text": "Нагартованная конструкция из алюминия обладает высокой устойчивостью к механическим повреждениям, что упрощает монтаж и обработку. Такой параметр позволяет использовать материал в различных условиях, обеспечивая надежное соединение элементов.",
          "html_text": "",
          "block_type": "unique",
          "characteristic_name": "Состояние",
          "characteristic_value": "нагартованная",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
          "status": "processed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
