        },
        {
          "id": "block_description_template_7",
          "fragment_name": "Труба_алюминиевая_описание",
          "original_text": "Легкие трубы из алюминия подходят для различных конструкций. Их низкий вес упрощает монтаж, а также снижает нагрузку на основание.",
          "processed_text": "Легкие трубы из алюминия подходят для различных конструкций. Их низкий вес упрощает монтаж, а также снижает нагрузку на основание.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
