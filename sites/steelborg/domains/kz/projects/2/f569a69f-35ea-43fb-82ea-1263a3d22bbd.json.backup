        },
        {
          "id": "block_description_template_14",
          "fragment_name": "Труба_алюминиевая_описание",
          "original_text": "Алюминиевая конструкция обладает легким весом, что упрощает транспортировку. Она имеет круглую или прямоугольную форму, что позволяет использовать ее в различных сферах. Труба из алюминия устойчива к коррозии, что делает ее подходящей для наружных работ.",
          "processed_text": "Алюминиевая конструкция обладает легким весом, что упрощает транспортировку. Она имеет круглую или прямоугольную форму, что позволяет использовать ее в различных сферах. Труба из алюминия устойчива к коррозии, что делает ее подходящей для наружных работ.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
