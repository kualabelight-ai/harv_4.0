        },
        {
          "id": "block_description_template_5",
          "fragment_name": "Труба_алюминиевая_описание",
          "original_text": "Алюминиевый трубопровод используется в строительстве и промышленности благодаря легкости и коррозионной стойкости. Продукция имеет гладкую поверхность, что упрощает монтаж и обеспечивает эффективный поток. Такие элементы часто применяются для создания каркасных конструкций и систем водоснабжения.",
          "processed_text": "Алюминиевый трубопровод используется в строительстве и промышленности благодаря легкости и коррозионной стойкости. Продукция имеет гладкую поверхность, что упрощает монтаж и обеспечивает эффективный поток. Такие элементы часто применяются для создания каркасных конструкций и систем водоснабжения.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
