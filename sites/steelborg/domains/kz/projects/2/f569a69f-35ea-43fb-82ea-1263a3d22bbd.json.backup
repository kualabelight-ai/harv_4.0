        },
        {
          "id": "block_new_block_1779778327_16",
          "fragment_name": "Труба_алюминиевая_преимущества",
          "original_text": "Изделие отличается легким весом и высокой коррозионной стойкостью. Алюминиевая труба подходит для применения в условиях повышенной влажности, что увеличивает срок службы конструкции.",
          "processed_text": "Изделие отличается легким весом и высокой коррозионной стойкостью. Алюминиевая труба подходит для применения в условиях повышенной влажности, что увеличивает срок службы конструкции.",
          "html_text": "",
          "block_type": "other",
