        },
        {
          "id": "char_9112167 06_отожженная_2",
          "fragment_name": "Труба_алюминиевая_Состояние_отожженная",
          "original_text": "Отожженные алюминиевые трубы обладают повышенной пластичностью, что позволяет им лучше противостоять механическим нагрузкам и коррозии. Это состояние улучшает эксплуатационные характеристики, делая материал более подходящим для различных условий.",
          "processed_text": "Отожженные алюминиевые трубы обладают повышенной пластичностью, что позволяет им лучше противостоять механическим нагрузкам и коррозии. Это состояние улучшает эксплуатационные характеристики, делая материал более подходящим для различных условий.",
          "html_text": "",
          "block_type": "unique",
          "characteristic_name": "Состояние",
          "characteristic_value": "отожженная",
          "errors": [],
          "manually_fixed": false,
