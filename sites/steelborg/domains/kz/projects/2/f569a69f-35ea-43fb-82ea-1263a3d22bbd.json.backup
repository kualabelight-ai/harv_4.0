        {
          "id": "block_new_block_1779778817_11",
          "fragment_name": "Труба_алюминиевая_подбор",
          "original_text": "При выборе алюминиевой конструкции важно учитывать диаметр, толщину стенки, а также предназначение. Неправильные параметры могут привести к снижению функциональности изделия.",
          "processed_text": "При выборе алюминиевой конструкции важно учитывать диаметр, толщину стенки, а также предназначение. Неправильные параметры могут привести к снижению функциональности изделия.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
