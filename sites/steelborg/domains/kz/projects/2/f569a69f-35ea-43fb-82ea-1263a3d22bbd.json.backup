          "last_modified": "2026-07-03T10:57:26.887918"
        },
        {
          "id": "block_description_template_8",
          "fragment_name": "Труба_алюминиевая_описание",
          "original_text": "Изделие из алюминия обладает легким весом и высокой коррозионной стойкостью. Продукция подходит для создания конструкций, требующих минимальных затрат на транспортировку. Использование в системах отопления или водоснабжения позволяет снизить риск утечек благодаря герметичному соединению.",
          "processed_text": "Изделие из алюминия обладает легким весом и высокой коррозионной стойкостью. Продукция подходит для создания конструкций, требующих минимальных затрат на транспортировку. Использование в системах отопления или водоснабжения позволяет снизить риск утечек благодаря герметичному соединению.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
          "status": "processed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
