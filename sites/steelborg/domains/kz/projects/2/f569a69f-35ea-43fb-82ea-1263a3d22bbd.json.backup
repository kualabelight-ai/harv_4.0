        {
          "id": "block_new_block_1779776713_4",
          "fragment_name": "Труба_алюминиевая_свойства",
          "original_text": "Продукция из алюминия сохраняет стабильные характеристики в условиях эксплуатации. Материал не подвержен коррозии, что обеспечивает долгий срок службы и минимальные затраты на обслуживание.",
          "processed_text": "Продукция из алюминия сохраняет стабильные характеристики в условиях эксплуатации. Материал не подвержен коррозии, что обеспечивает долгий срок службы и минимальные затраты на обслуживание.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
          "status": "processed",
