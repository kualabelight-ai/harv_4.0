          "last_modified": "2026-07-03T10:57:26.885905"
        },
        {
          "id": "char_9112167 06_нагартованная_2",
          "fragment_name": "Труба_алюминиевая_Состояние_нагартованная",
          "original_text": "Нагартованная продукция демонстрирует высокие механические свойства, такие как устойчивость к деформациям и повышенная прочность. Это делает ее подходящей для использования в ответственных конструкциях и системах.",
          "processed_text": "Нагартованная продукция демонстрирует высокие механические свойства, такие как устойчивость к деформациям и повышенная прочность. Это делает ее подходящей для использования в ответственных конструкциях и системах.",
          "html_text": "",
          "block_type": "unique",
          "characteristic_name": "Состояние",
          "characteristic_value": "нагартованная",
          "errors": [],
          "manually_fixed": false,
