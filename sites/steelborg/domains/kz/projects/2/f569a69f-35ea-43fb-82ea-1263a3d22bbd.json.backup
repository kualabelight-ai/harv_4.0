        },
        {
          "id": "block_new_block_1779776713_18",
          "fragment_name": "Труба_алюминиевая_свойства",
          "original_text": "Изделие отличается легкостью и высокой коррозионной стойкостью. Оно обладает отличными механическими характеристиками, что делает продукцию востребованной в строительстве и промышленности. Устойчивость к воздействию внешней среды обеспечивает долгий срок службы.",
          "processed_text": "Изделие отличается легкостью и высокой коррозионной стойкостью. Оно обладает отличными механическими характеристиками, что делает продукцию востребованной в строительстве и промышленности. Устойчивость к воздействию внешней среды обеспечивает долгий срок службы.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
          "status": "processed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
          "special_symbols": [],
          "last_modified": "2026-07-03T10:57:26.887918"
        },
        {
          "id": "block_new_block_1779776713_19",
          "fragment_name": "Труба_алюминиевая_свойства",
          "original_text": "Изделие состоит из алюминия с добавлением магния, кремния, меди. Магний повышает коррозионную стойкость, кремний улучшает формуемость, а медь увеличивает прочность. Алюминиевая труба подходит для различных промышленных применений благодаря своим легким и устойчивым характеристикам.",
          "processed_text": "Изделие состоит из алюминия с добавлением магния, кремния, меди. Магний повышает коррозионную стойкость, кремний улучшает формуемость, а медь увеличивает прочность. Алюминиевая труба подходит для различных промышленных применений благодаря своим легким и устойчивым характеристикам.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
