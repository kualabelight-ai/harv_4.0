        },
        {
          "id": "block_new_block_1779778598_2",
          "fragment_name": "Труба_алюминиевая_разновидности",
          "original_text": "Существуют несколько типов алюминиевых труб. Прямые изделия подходят для водопроводных систем, а изогнутые — для сложных конструкций. Трубы с анодированным покрытием защищают от коррозии, в то время как полированные варианты обеспечивают эстетичный вид.",
          "processed_text": "Существуют несколько типов алюминиевых труб. Прямые изделия подходят для водопроводных систем, а изогнутые — для сложных конструкций. Трубы с анодированным покрытием защищают от коррозии, в то время как полированные варианты обеспечивают эстетичный вид.",
          "html_text": "",
          "block_type": "other",
          "characteristic_name": "",
          "characteristic_value": "",
          "errors": [],
          "manually_fixed": false,
          "warnings": [],
          "status": "processed",
          "manual_correction": null,
          "auto_corrected": false,
          "added_value": null,
